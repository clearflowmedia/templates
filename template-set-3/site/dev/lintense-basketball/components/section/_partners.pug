// Partners
section#partners.section.section-lg.bg-gray
	.container
		h6 Our friends & partners
		.owl-carousel.owl-style-1(data-items='1',
			data-sm-items='2',
			data-md-items='3',
			data-lg-items='4',
			data-xl-items='5',
			data-xxl-items='6',
			data-owl= {
				dots: true,
				autoplayTimeout: 3500,
			})

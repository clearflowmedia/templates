include ../quote/_quote
// Testimonials
section#testimonials.section.section-xl.bg-additional
	.container
		h6 testimonials
		h3 Feedback from our clients
		.row.row-lg.row-50.row-lg-85
			.col-lg-4
				+quote-simple({
                    text: 'My father was in a serious motorcycle accident and unfortunately passed away soon after the accident. Lintense Law firm in Atlanta was a true blessing in this difficult time. ',
                    author: 'Emma Williamson'
                })
			.col-lg-4
				+quote-simple({
                    text: 'I’m so happy with the team at Lintense! The entire staff is so welcoming, professional and are all outstanding experts. I’m especially grateful for my handling attorney, Kevin Jackson. Since day one he provided positive, hopeful yet realistic assurances, regarding my case of motor vehicle collision, which was a life altering interruption.',
                    author: 'Peter Adams'
                })
			.col-lg-4
				+quote-simple({
                    text: 'I have worked closely with Jerome Bell for years. He is extremely professional and responsive.',
                    author: 'Ann Smith'
                })

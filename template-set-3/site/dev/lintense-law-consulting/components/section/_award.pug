// Awards
section#awards.section.section-xl.bg-default
	.container
		.row.row-30.row-lg-50.row-xl-85
			.col-md-6
				h6 Distinctive Recognition
				h3 Award-winning practice
				p.pr-xl-5 Take a look at our awards and achievements to find out more about Lintense law firm and the results of our work.
			.col-md-6
				.row.row-30.row-md-40
					.col-sm-6
						+box-award({
							img: 'award-01-70x70.svg',
							title: 'The Legal 500 EMEA 2021'
						}).bordered
					.col-sm-6
						+box-award({
							img: 'award-02-70x70.svg',
							title: 'Best Referral Firm (2020)'
						}).bg-additional
					.col-sm-6
						+box-award({
							img: 'award-03-70x70.svg',
							title: 'Best Attorney (2019)'
						}).context-dark.bg-primary
					.col-sm-6
						+box-award({
							img: 'award-04-70x70.svg',
							title: 'US Legal Awards (2018)'
						}).context-dark.bg-secondary
.container.mt-0: hr


// Services
section#services.section.section-xl.bg-default
	.container
		h6 our services
		h3 Our legal practice areas
		.row.row-lg.row-40.row-lg-50.row-xl-85
			.col-sm-6.col-md-4
				+box-service({
					number: '01',
					title: 'Family law',
					text: 'We aim to support families in resolving their own disputes. We ensure professional consultancy and result.'
				})
			.col-sm-6.col-md-4
				+box-service({
					number: '02',
					title: 'Business law',
					text: 'Professional help with financial, commercial, tax disputes and other complex business issues.'
				})
			.col-sm-6.col-md-4
				+box-service({
					number: '03',
					title: 'Civil litigation',
					text: 'Your civil rights will be defended and represented on the highest level with the best outcome.'
				})
			.col-sm-6.col-md-4
				+box-service({
					number: '04',
					title: 'Insurance defense',
					text: 'We understand how to handle the complex statutory and contractual issues that frequently arise in claims.'
				})
			.col-sm-6.col-md-4
				+box-service({
					number: '05',
					title: 'Land & asset',
					text: 'Lintense offers consultancy services and asset management, bringing a new vision to the world of investment.'
				})
			.col-sm-6.col-md-4
				+box-service({
					number: '06',
					title: 'Financial law',
					text: 'We work in an open dialogue with you in order to devise the strategy which will best serve your interests.'
				})

// Pricing
section#pricing.section.section-xl.bg-default
	.container
		h6 pricing
		h3 Get the right price with us
		.row.row-lg.row-50
			.col-12
				.table-wrap
					table.table-custom
						thead
							tr
								th.first-column
								th.second-column
									.pricing-pack.pricing-pack-primary
										.h4 Premium member
								th.third-column
									.pricing-pack.pricing-pack-additional
										.h4 Non-member
						tbody
							tr
								td.first-column
									h4 Legal documents
									ul.list.list-marked
										li.list-item Easy-to-create, reliable documents for hundreds of purposes
										li.list-item Sign online in seconds
										li.list-item Share, download and print anytime
								td.second-column
									.h3.text-primary Free
								td.third-column
									.h3 $39.99
									p.subtitle-sm per document

							tr
								td.first-column
									h4 Attorney services
									p Document defense service for personal & corporate legal documents
								td.second-column
									.h3.text-primary Free
								td.third-column
									.h3 $9.99
									p.subtitle-sm per document

							tr
								td.first-column
									p Ask a Lawyer your legal questions
								td.second-column
									.h3.text-primary Free
								td.third-column
									.h3 $49.99
									p.subtitle-sm per question

							tr
								td.first-column
									p 30-minute consultation on every new legal matter
								td.second-column
									.h3.text-primary Free
								td.third-column
									.h3 $59.99
									p.subtitle-sm per consultation

							tr
								td.first-column
									p Discounts when you hire a Lintense attorney
								td.second-column
									.h3.text-primary Up to 40% off
								td.third-column
									.h3.text-third Unavailable

							tr
								td.first-column
									h4 For business
									p Affordable incorporation filing
								td.second-column
									.h3.text-primary Free
									p.subtitle-sm for new members. 25% off thereafter
								td.third-column
									.h3 $99.99
									p.subtitle-sm (Excluding state fees)

							tr
								td.first-column
									p Affordable Registered Agent service
								td.second-column
									.h3.text-primary 25% off
								td.third-column
									.h3 $149.99




// schedule
section#schedule.section.section-xl.bg-default
    .container
        .row.row-30.row-lg-50
            .col-lg-8
                .h5.sup.text-primary Line Up
                h2.h3 Schedule details
            .col-lg-9.offset-lg-1
                .box.box-schedule(data-animate!={class: 'fadeInUp'} )
                    h4.box-schedule-title Registration
                    .box-schedule-desc
                        h6.box-schedule-desc-title time
                        .box-schedule-desc-value 8:30am
                    .box-schedule-desc
                        h6.box-schedule-desc-title where
                        .box-schedule-desc-value 2464 Royal Ln. Mesa, New Jersey 45463
                    .box-schedule-desc
                        h6.box-schedule-desc-title parking
                        .box-schedule-desc-value Uber, Lyft, or Taxi are recommended
                            br
                            | Limited parking garages nearby
                    .box-schedule-desc
                        h6.box-schedule-desc-title details
                        .box-schedule-desc-value After arriving to the event venue, you’ll be asked to fill in the registration form. Then, visitors will be invited to the first workshop of Lintense.
                    .box-schedule-main
                        .box-schedule-main-item
                            h4.box-schedule-main-title 9:30am - 10:30am
                            .box-schedule-main-content
                                q.lead.box-schedule-main-quote Beginner’s Guide to Calisthenics: Benefits & Excercises
                                h5.box-schedule-main-author Devon Lane
                                .box-schedule-main-specializaation Calisthenics
                        .box-schedule-main-item
                            h4.box-schedule-main-title 10:40am - 12:30am
                            .box-schedule-main-content
                                q.lead.box-schedule-main-quote Unknown Advantages of Tantric Practices
                                h5.box-schedule-main-author Ronald Richards
                                .box-schedule-main-specializaation Tantra yoga
                .box.box-schedule(data-animate!={class: 'fadeInUp'})
                    h4.box-schedule-title Lunch
                    .box-schedule-desc
                        h6.box-schedule-desc-title time
                        .box-schedule-desc-value 1:00pm - 2:00pm
                    .box-schedule-desc
                        h6.box-schedule-desc-title where
                        .box-schedule-desc-value 2464 Royal Ln. Mesa, New Jersey 45463
                    .box-schedule-desc
                        h6.box-schedule-desc-title details
                        .box-schedule-desc-value 60% organic, vegetarian catering with some possible intake of animal proteins (eggs, fish)
                    .box-schedule-main
                        .box-schedule-main-item
                            h4.box-schedule-main-title 2:10pm - 4:00pm
                            .box-schedule-main-content
                                q.lead.box-schedule-main-quote Hatha Yoga as a Way of Relaxation
                                h5.box-schedule-main-author Leslie Alexander
                                .box-schedule-main-specializaation Hatha yoga
                        .box-schedule-main-item
                            h4.box-schedule-main-title 4:10pm - 5:30pm
                            .box-schedule-main-content
                                q.lead.box-schedule-main-quote Finding Muscle Balance Via Training & Excercises
                                h5.box-schedule-main-author Bessie Cooper
                                .box-schedule-main-specializaation Bodyweight training
                .box.box-schedule(data-animate!={class: 'fadeInUp'} )
                    h4.box-schedule-title after party
                    .box-schedule-desc
                        h6.box-schedule-desc-title time
                        .box-schedule-desc-value 6:00pm to 8:30pm
                    .box-schedule-desc
                        h6.box-schedule-desc-title where
                        .box-schedule-desc-value 2464 Royal Ln. Mesa, New Jersey 45463
                    .box-schedule-desc
                        h6.box-schedule-desc-title details
                        .box-schedule-desc-value The after party of Lintense features discussion of questions with our guests and speakers as well as live music from invited performers.


//- Pricing
	@param {object} data.icon - icon class
	@param {object} data.title - pricing title
	@param {object} data.price - pricing price per month
mixin pricing( data )
	// Pricing
	article.pricing&attributes( attributes )
		.pricing-icon( class= data.icon )
		.pricing-title.h3!= data.title
		.pricing-list
			ul.list.list-lg.list-marked.list-primary.d-inline-block.text-left
				each item in data.items
					li.list-item= item
		.pricing-price.h3= '$' + data.price
		.pricing-btn
			a.btn.btn-round.btn-sm.btn-dark.btn-nuka( href='#registration', data-anchor-link ) Book Now!
				span.btn-overlay
// Our Pastor
section#our-pastor.section.section-xl.bg-default
	.container
		.row
			.col.text-center( data-animate!={class: 'fadeInUp'} )
				h3.h6  Meet our Pastor
				h2 Thomas Smith
		.row.row-30.align-items-center
			.col-lg-4.text-center.text-lg-start(data-animate!={class: 'fadeInLeft'} )
				+img('index-01-400x400').rounded-circle
			.col-lg-7.offset-lg-1(data-animate!={class: 'fadeInRight'} )
				article.quote
					+img('testimonia-icon-46x35.svg').quote-icon
					.quote-body
						q.quote-text As a long-time serving pastor at Lintense, I am committed to serving and helping people that come to our church. Fueled by prayer and the Bible, I am passionate about building the local church and advancing God’s kingdom on Earth. Whatever brings you to Lintense, you’ll surely find the support you need to tackle any kind of life struggles and everyday challenges.
				a.btn.btn-icon.btn-icon-right.btn-light-outline(href='#')
					span.icon.mdi.mdi-arrow-right
					| Follow pastor

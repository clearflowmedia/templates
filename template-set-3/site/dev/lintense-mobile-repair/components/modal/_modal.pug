//Modal
#consultation.modal.fade.text-start(tabindex='-1', role='dialog')
	.modal-dialog.modal-lg.modal-dialog-centered
		// Modal content
		.modal-content
			.modal-header
				h4.modal-title Request consultation
				button.btn-close(type='button', data-bs-dismiss='modal', aria-label='close'): span.icon.mdi.mdi-close
			.modal-body
				p.small Enter your contacts below to schedule an appointment or discuss it with us in details.
				form.rd-mailform.form-modal( data-form-output='form-output-global', data-form-type='contact', method='post', action='components/rd-mailform/rd-mailform.php' )
					.form-group
						input.form-control( type='text', name='name', placeholder='Name *', data-constraints='@Required' )
					.form-group
						input.form-control( type='email', name='email', placeholder='Email *', data-constraints='@Email @Required' )
					.form-group
						input.form-control( type='text', name='phone', placeholder='Phone *', data-constraints='@PhoneNumber @Required' )

					button.btn.btn-primary( type='submit' ) Submit

#form-output-global.form-output.snackbar.snackbar-primary

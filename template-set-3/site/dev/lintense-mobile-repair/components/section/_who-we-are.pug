include ../advantage/_advantage

// Who we are
section#who-we-are.section.section-lg.bg-default
	.container
		.row.row-30
			.col-md-4
				h5 Who we are
			.col-md-8.col-lg-6
				p.lead Accidents happen, and it’s our job to fix them when it comes to damaging your mobile device. It’s never been easier to render your device useless after dropping it. Our trained technicians will diagnose and repair your device within 24 hours.
		.row.row-lg.row-30.row-reset
			.col-md-6.col-lg-4
				+advantage({
					title: 'No fix no fee',
					text: 'We aim to provide honest service to our customers. So if you don’t get proper repair service, you won’t be charged.'
				})
			.col-md-6.col-lg-4
				+advantage({
					title: 'Quick repair process',
					text: 'We guarantee a quick repair service regardless of how complex the task is.'
				})
			.col-md-6.col-lg-4
				+advantage({
					title: '30 days of warranty',
					text: 'All our repairs come with a 30-day limited warranty on the service we provide. You can always expect high reliability from us.'
				})

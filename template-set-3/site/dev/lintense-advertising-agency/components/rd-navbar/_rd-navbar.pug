include _navigation

mixin rd-navbar
	//RD Navbar
	header.rd-navbar-wrap.rd-navbar-wrap-absolute( data-preset!={ title:'Navbar Default', category:'header', reload:true, id:'navbar-default' } )
		nav.rd-navbar&attributes( attributes )
			.navbar-container
				.navbar-cell.navbar-cell-center
					.navbar-panel
						button.navbar-switch.mdi-menu.novi-icon( data-multi-switch!= {
							targets: '.rd-navbar',
							scope:   '.rd-navbar',
							isolate: '[data-multi-switch]'
						})

						.navbar-logo
							a.navbar-logo-link( href='index.html' )
								+img( logo.default ).navbar-logo-default( alt= logo.name )
								+img( logo.inverse ).navbar-logo-inverse( alt= logo.name )

					.navbar-sidebar
						+navigation( menu )

				.navbar-cell
					.rd-search-wrap
						button.navbar-button.navbar-button-search( data-multi-switch!= {
							targets: '.rd-navbar',
							scope:   '.rd-navbar',
							class:   'navbar-search-active',
							isolate: '[data-multi-switch]:not( .navbar-button )'
						})

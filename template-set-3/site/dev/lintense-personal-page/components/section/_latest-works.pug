include ../thumbnail/_thumbnail

// Latest works
section#portfolio.section.section-md.bg-100.overflow-hidden.novi-bg.novi-bg-image
	.container
		.row.row-30.row-lg-50.justify-content-md-between.align-items-center.row-fix
			.col-sm-8.col-md-7.col-xxl-5
				h2.text-decoration( data-animate!={ class: 'fadeIn' } ) Latest works

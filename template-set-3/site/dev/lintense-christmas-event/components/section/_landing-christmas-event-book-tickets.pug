include ../countdown/_countdown

// Book Tour Event Tickets
section#book-tickets.section.section-lg.section-lg-3.bg-primary.context-dark.text-center.position-relative
	#particles-js-5.particles-js
	.container
		h1( data-animate!={ class: 'fadeInUp' } )
			span.position-relative B
				+img( 'image-03-195x182.png' ).position-absolute( style='top: -38%; left: -124%; width: 1.573em; max-width: none;' )
			| ook Your
			br
			| Event Tickets
		+countdown({ from: '2020-03-20', to: '2020-12-01' }).justify-content-center( data-animate!={ class: 'fadeInUp' } )
		.offset-lg( data-animate!={ class: 'fadeInUp' } )
			//RD Mailform
			form.rd-mailform( data-form-output='form-output-global-2', data-form-type='contact', method='post', action='components/rd-mailform/rd-mailform.php' )
				.row.row-20.gutters-20
					.col-xs-6.col-lg-3
						.form-group
							input.form-control( type='text', name='first-name', placeholder='First name', data-constraints='@Required' )
					.col-xs-6.col-lg-3
						.form-group
							input.form-control( type='text', name='last-name', placeholder='Last name', data-constraints='@Required' )
					.col-xs-6.col-lg-3
						.form-group
							input.form-control( type='text', name='phone', placeholder='Phone number', data-constraints='@Required @PhoneNumber' )
					.col-xs-6.col-lg-3
						.form-group
							input.form-control( type='email', name='email', placeholder='Email address', data-constraints='@Email @Required' )
				.offset-md
					button.btn.btn-lg.btn-secondary.btn-nuka( type='submit' ) Register Now!
						span.btn-overlay

		#form-output-global-2.form-output.snackbar.snackbar-secondary
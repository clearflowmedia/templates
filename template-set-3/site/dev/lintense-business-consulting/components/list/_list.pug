//- List social
mixin list-social( data )
	- data = data || {}
	// List social
	ul.list.list-social&attributes( attributes )
		li.list-social-item
			a.icon.icon-social.fa-twitter( class= data.iconClass ? data.iconClass : 'icon-sm', href='#' aria-label='twitter')
		li.list-social-item
			a.icon.icon-social.fa-youtube-play( class= data.iconClass ? data.iconClass : 'icon-sm', href='#' aria-label='youtube')
		li.list-social-item
			a.icon.icon-social.fa-facebook-square( class= data.iconClass ? data.iconClass : 'icon-sm', href='#' aria-label='facebook')
		li.list-social-item
			a.icon.icon-social.fa-instagram( class= data.iconClass ? data.iconClass : 'icon-sm', href='#' aria-label='instagram')
		li.list-social-item
			a.icon.icon-social.fa-linkedin-square( class= data.iconClass ? data.iconClass : 'icon-sm', href='#' aria-label='linkedin')

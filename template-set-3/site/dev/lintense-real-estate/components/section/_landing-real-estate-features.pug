include ../lin-icon/_lin-icon

// Features
section#features.section.section-lg.bg-secondary.context-dark.overlay-secondary.overlay-08.bg-image( style='background-image: url(images/image-05-1920x1267.jpg);' )
	.container
		.row.row-40.row-xl-70
			.col-xs-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				article.blurb
					+lin-villa.lin-lg.blurb-icon
					.blurb-title.h5 LUXURY VILLA by the sea
					.blurb-text.block.block-sm This property is located near the seaside and has a stunning view.
			.col-xs-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				article.blurb
					+lin-blueprint.lin-lg.blurb-icon
					.blurb-title.h5 Big Area: 298 sq. m.
					ul.list.blurb-list.block.block-sm
						li.list-item 4 Bedrooms
						li.list-item Shared lounge/TV area
						li.list-item Designated smoking area
						li.list-item Heating
						li.list-item Family rooms
			.col-xs-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				article.blurb
					+lin-tree.lin-lg.blurb-icon
					.blurb-title.h5 Nature All Around You
					ul.list.blurb-list.block.block-sm
						li.list-item Outdoor furniture
						li.list-item Sun terrace
						li.list-item BBQ facilities
			.col-xs-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				article.blurb
					+lin-swimming-pool.lin-lg.blurb-icon
					.blurb-title.h5 Pool and wellness
					ul.list.blurb-list.block.block-sm
						li.list-item Swimming pool
						li.list-item Sun umbrellas
						li.list-item Sun loungers or beach chairs
						li.list-item Pool/beach towels
			.col-xs-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				article.blurb
					+lin-garage.lin-lg.blurb-icon
					.blurb-title.h5 Get Free Parking Place
					.blurb-text.block.block-sm Secured and covered parking
			.col-xs-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				article.blurb
					+lin-shield-check.lin-lg.blurb-icon
					.blurb-title.h5 24/7 Security
					.blurb-text.block.block-sm This property also has 24/7 security to ensure you won’t be disturbed during your stay.

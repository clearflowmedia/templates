//- Thumbnail
	@param {object} data - data object
	@param {string} data.imgOriginal - thumb img original
	@param {string} data.img - thumb img
mixin thumbnail( data )
	// Thumbnail
	a.thumbnail.lightgallery-item( href='images/' + data.imgOriginal + '.jpg' )
		+img( data.img ).thumbnail-image
		span.thumbnail-icon +

//- Thumbnail default
	@param {object} data - data object
	@param {string} data.imgOriginal - thumb img original
	@param {string} data.img - thumb img
mixin thumbnail-default( data )
	// Thumbnail
	.thumbnail.thumbnail-default
		a.thumbnail-default-media( href='#' )
			+img( data.img ).thumbnail-default-image
		h4.thumbnail-default-title: a( href='#' )= data.title
		.thumbnail-default-caption= data.caption


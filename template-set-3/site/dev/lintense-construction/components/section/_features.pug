include ../blurb/_blurb

// Features
section#services.section.section-lg.bg-transparent.text-center
	.container
		.row.row-30.text-sm-start
			.col-sm-6.col-lg-3.d-flex.justify-content-center
				+blurb-boxed({
					title: 'Design',
					text: 'We provide top-notch design services for corporate and residential projects with a detailed and professional approach to all aspects, including:',
					list: [
						'Conceptual design',
						'Design development',
						'3D modeling',
					],
				})
			.col-sm-6.col-lg-3.d-flex.justify-content-center
				+blurb-boxed({
					title: 'Architecture',
					text: 'When offering architectural services, we ensure that every stage of the project is completed thoroughly. Our team also pays attention to:',
					list: [
						'Project management',
						'Site selection',
						'Feasibility studies',
						'Bidding and negotiation',
					],
				})
			.col-sm-6.col-lg-3.d-flex.justify-content-center
				+blurb-boxed({
					title: 'Construction',
					text: 'Working on a building’s construction process is an important part of any project we work on. It consists of varied stages, such as:',
					list: [
						'Pre-construction',
						'Procurement',
						'Commissioning',
					],
				})
			.col-sm-6.col-lg-3.d-flex.justify-content-center
				+blurb-boxed({
					title: 'Renovation',
					text: 'Our team also provides renovation services that allow you to transform your property and optimize your home’s space:',
					list: [
						'Kitchen renovation',
						'Loft conversion',
						'Decking',
						'Landscaping',
					],
				})
		a.btn.btn-gray( href='#' )
			span.btn-icon.icomoon-phone
			span Get a Consultation
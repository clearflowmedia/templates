// Footer
footer#newsletter.section.footer.footer-sm.bg-900.context-dark.text-400
	.container
		.row.row-20.align-items-lg-center
			.col-md-5.col-lg-6.col-xl-7
				.group-x-20.group-y-10.d-flex.flex-wrap.align-items-center.align-items-xl-baseline
					span.h4 Newsletter
					span Subscribe to our newsletter to receive fresh news and updates.
			.col-md-7.col-lg-6.col-xl-5
				form.rd-mailform.form-inline.flex-xl-nowrap.group-20( data-form-output='form-output-subscribe', data-form-type='subscribe', method='post', action='components/rd-mailform/rd-mailform.php' )
					.form-inline-group
						input.form-control.form-control-lg( type='email', name='email', placeholder='Enter your email address', data-constraints='@Email @Required' )
					button.btn.btn-lg.btn-nuka( type='submit' ) Submit
						span.btn-overlay
				#form-output-subscribe.form-output.snackbar.snackbar-secondary


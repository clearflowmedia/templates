// WHAT I DO
section.section.section-lg.bg-transparent
	.container
		.row.row-30.tab
			.col-xl-3
				h6 WHAT I DO
			.col-xl-4.col-xs-4
				.tab-nav
					ul.nav
						li.nav-item( role='presentation' )
							a.nav-link.active.show( href='#tabs-1-1', data-toggle='tab' ) PORTRAIT
						li.nav-item( role='presentation' )
							a.nav-link( href='#tabs-1-2', data-toggle='tab' ) FASHION
						li.nav-item( role='presentation' )
							a.nav-link( href='#tabs-1-3', data-toggle='tab' ) Lifestyle
						li.nav-item( role='presentation' )
							a.nav-link( href='#tabs-1-4', data-toggle='tab' ) Commercial
			.col-xl-5.col-xs-8
				//Tab panes
				.tab-content
					#tabs-1-1.tab-pane.fade.active.show
						p.text-uppercase Portraiture is one of the most popular genres of photography.
						p The goal of portraiture is to show the character of a subject – to capture the person’s personality and emotion in an image.
						a.link-arrow( href='#' )
							span vIEW GALLERY
							+arrow
					#tabs-1-2.tab-pane.fade
						p.text-uppercase Fashion photography is devoted to displaying fashionable clothing.
						p This type of photography showcases and glamorizes fashion clothing, shoes, and accessories to make them more desirable.
						a.link-arrow( href='#' )
							span vIEW GALLERY
							+arrow
					#tabs-1-3.tab-pane.fade
						p.text-uppercase Lifestyle photography captures real-life situations in an artistic manner.
						p If the aim of a photographer is to share a story through candid scenes, lifestyle photography can do it the best way.
						a.link-arrow( href='#' )
							span vIEW GALLERY
							+arrow
					#tabs-1-4.tab-pane.fade
						p.text-uppercase Commercial photography involves taking pictures for commercial use.
						p A commercial photographer can convey a message of your brand properly, especially if you are using the photos in an advertising campaign.
						a.link-arrow( href='#' )
							span vIEW GALLERY
							+arrow

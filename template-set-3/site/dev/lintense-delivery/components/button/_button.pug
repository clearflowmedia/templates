//- Button App
mixin button-store
	.btns.group-20
		a.btn.btn-700.btn-store( href='#' )
			span.icon-lg.mr-1.text-primary.mdi.mdi-apple
			span
				span.btn-store-text-small Available on
				span.btn-store-text App Store
		a.btn.btn-700.btn-store( href='#' )
			span.icon-lg.mr-1.text-primary.mdi.mdi-google-play
			span
				span.btn-store-text-small Available on
				span.btn-store-text Google Play

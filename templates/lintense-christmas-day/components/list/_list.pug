//- List social
mixin list-social( data )
	- data = data || {}
	// List social
	ul.list.list-social&attributes( attributes )
		li.list-social-item
			a.icon.icon-circle.icon-xxs.shadow-none.mdi-youtube-play( href='#' )
		li.list-social-item
			a.icon.icon-circle.icon-xxs.shadow-none.mdi-facebook( href='#' )
		li.list-social-item
			a.icon.icon-circle.icon-xxs.shadow-none.mdi-instagram( href='#' )
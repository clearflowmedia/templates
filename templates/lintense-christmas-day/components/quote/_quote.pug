//- Quote
	@param {object} data - data object
	@param {string} data.text - quote text
	@param {string} data.img - image of author
	@param {string} data.name - name of author
mixin quote( data )
	// Quote
	article.quote&attributes( attributes )
		.media.media-md.flex-column.flex-xs-row
			.media-left
				+img( data.img ).quote-author-image.mt-2
			.media-body
				.quote-text.h4= data.text
				.quote-author-name.h4= data.name

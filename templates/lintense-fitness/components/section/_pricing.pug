// Pricing
section#pricing.section.section-lg.bg-default
	.container
		.row.justify-content-center
			.col-md-10.col-xl-8.col-xxl-7.text-center
				h2 Select your pricing plan
				p.lead We offer three varied pricing plans to satisfy the needs of every customer. From group training to individual workouts, there’s something for everyone.
		.row.row-30
			.col-md-6.col-lg-4
				article.pricing
					.pricing-header
						h4.pricing-title Basic
						.pricing-price $40.00
					.pricing-body
						ul.list-lg
							li.list-item Gym
							li.list-item Crossfit
							li.list-item Yoga
						a.btn.btn-isi(href='#') Choose
			.col-md-6.col-lg-4
				article.pricing
					.pricing-header
						h4.pricing-title Standart
						.pricing-price $60.00
					.pricing-body
						ul.list-lg
							li.list-item Gym
							li.list-item Crossfit
							li.list-item Yoga
							li.list-item Pilates
							li.list-item Boxing
						a.btn.btn-isi(href='#') Choose
			.col-md-6.col-lg-4
				article.pricing
					.pricing-header
						h4.pricing-title Premium
						.pricing-price $99.00
					.pricing-body
						ul.pricing-list.list-lg
							li.list-item Gym
							li.list-item Crossfit
							li.list-item Yoga
							li.list-item Pilates
							li.list-item Boxing
							li.list-item Personal Coach
						a.btn.btn-isi(href='#') Choose
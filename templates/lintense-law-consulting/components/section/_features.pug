// Features
section#features.section.section-xl.bg-default
	.container
		h6 Our features
		h3 Why you can trust us
		p At Lintense, we understand what is required to successfully represent our clients’ interests at court. Here’s why our clients choose us.
		.row.row-30
			.col-md-6.col-xl-3
				+box-feature-card({
					img: 'feature-01-50x50.svg',
					title: 'Any litigation',
					text: 'Our expertise covers a variety of civil litigation areas. From Labor & employment laws to family & child custody laws, we have it all covered.',
				})

			.col-md-6.col-xl-3
				+box-feature-card({
					img: 'feature-02-50x50.svg',
					title: 'Winning streak',
					text: 'We’ve got an amazing percentage of won cases.  These kinds of results were made possible thanks to our due diligence, timely efforts, and experience.',
				})

			.col-md-6.col-xl-3
				+box-feature-card({
					img: 'feature-03-50x50.svg',
					title: 'Timely work',
					text: 'Thanks to our extensive experience, we can achieve great results in a short amount of time without compromising on the case’s important details.',
				})

			.col-md-6.col-xl-3
				+box-feature-card({
					img: 'feature-04-50x50.svg',
					title: 'Affordable help',
					text: 'On par with such a client-friendly pace of work, we also have another uncompromised advantage that our clients prefer - our reasonable pricing!',
				})



//- Shop panel
section.shop-panel
  .container.text-center
    .row.align-items-sm-center.justify-content-sm-between
      .col-sm-4.text-sm-start
        ul.shop-panel-list
          li(class={'active': activeShopLayout == 0}): a.icon.icon-sm.material-icons-view_module(href='shop-grid.html')
          li(class={'active': activeShopLayout == 1}): a.icon.icon-sm.material-icons-view_list(href='shop-list.html')

      .col-sm-8.offset-top-15.offset-xs-top-0.text-sm-end
        .shop-panel-controls
          span Show
          //Select 2
          select.form-input.select-filter(data-minimum-results-for-search="Infinity", data-custom-theme='modern')
            option(value="3") 15
            option(value="4") 20
            option(value="5") 25
            option(value="6") 30
            option(value="8") 40
            option(value="9") 50

          span items per page

='\n'
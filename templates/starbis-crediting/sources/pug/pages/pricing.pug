extends  ../_skeleton

block variables
  - var activeIndex = 3
  - var pageName = 'Pricing'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title(pageName, 'bg-image-1', {
    0: {
      "title": "Home",
      "href": "./"
    },
    1: {
      "title": "Pages",
      "href": "#"
    },
    2: {
      "title": pageName
    }
  })

  //- Choose your plan
  section.section-75.section-lg-100.section-bottom-15.bg-whisper.text-lg-start
    .container
      .row.row-15.align-items-sm-center.justify-content-xl-between
        .col-md-6.col-lg-8
          .row.row-15.align-items-sm-center
            .col-lg-6
              h3.text-spacing-50 Choose Your Plan

            .col-lg-6
              p.text-gray.
                Pick the best plan that meets your business needs. A free trial is available to help you with the decision-making.

        .col-md-5.col-lg-4.col-xl-3
          a.btn.btn-primary.btn-block.btn-cta(href='#') Learn more

  ='\n'

  //- Pricing tables
  section.text-lg-start.bg-decoration-wrap.bg-decoration-bottom.section-75.section-lg-100.bg-whisper
    .container.bg-decoration-content
      .row.justify-content-md-center
        .col-lg-10.col-xl-12
          include ../_includes/_pricing-tables-range
    .bg-decoration-object.bg-wasip
  ='\n'

  section.section-60.section-md-100.bg-river
    .container.text-lg-start
      .row.row-30.align-items-sm-center
        .col-lg-8.col-xl-8
          h3 Not Sure Which Plan is Right For You?
          p.p-custom.text-gray.d-inline-block(style='max-width: 560px;').
            If you are in doubt of which plan to opt for, subscribe to our newsletter and we will try to help you make the right decision.
        .col-lg-4.col-xl-4.text-lg-end
          a.btn.btn-xl.btn-white-outline(href='contact-us.html') Send us a letter
  ='\n'

  //- Questions & Answers
  section.section-75.section-lg-100.text-lg-start.bg-default
    .container
      h2 Questions & Answers
      .row.justify-content-lg-center.row-offset-1
        .col-lg-11.col-xl-10
          .row.row-40
            .col-md-6
              dl.list-terms-variant-1
                dt Why are there so many rates?
                dd With so many interest rates on so many different kinds of loans out there, it is hard to know which is right for you. You shouldn’t take a rate just because it’s low. In fact, a lower rate on the wrong loan can cost you thousands of dollars. That’s why we discuss your financial goals with you.

                dt What are the advantages of buying a home?
                dd A home purchase gives you personal benefits such as a sense of investing in your community and pride for achieving the dream of homeownership. There are some strong financial benefits as well, especially the tax savings you may enjoy.

                dt How much do I need for a down payment?
                dd Your down payment requirements will depend on your lender, the type of home loan you choose and the type of property you are buying. Your required down payment can range anywhere from 3%-20% of the home's purchase price.

            .col-md-6
              dl.list-terms-variant-1
                dt What is mortgage insurance?
                dd Mortgage Insurance is usually required on a conventional loan any time that the down payment is less than 20% of the sales price (or the appraised value if the appraisal is lower than the sales price) of the property. Premiums vary based on the amount of down payment.

                dt What does “locking in a rate” mean?
                dd Interest rates fluctuate based on a variety of factors, including inflation, the pace of economic growth, and Federal Reserve policy. While interest rates are hard to predict, if you think rates are on an upward trend, you may want to consider locking in your interest rate.

                dt What is an escrow account?
                dd Lenders put a portion of your monthly mortgage loan payment into an escrow account – a holding bin of funds to cover your homeowners insurance, flood insurance if applicable, and your property taxes. When these payments are due, the lender pays them from the escrow account.
  ='\n'


  //- Page Footer
  include ../sections/_section-footer-default
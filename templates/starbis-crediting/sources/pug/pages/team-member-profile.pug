extends  ../_skeleton

//- Includes
include ../elements/_ui-thumbnail-3
include ../elements/_ui-quote-default

block variables
  - var activeIndex = 1
  - var pageName = 'Team member profile'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title('Our Team Member', 'bg-image-1', {
    0: {
      "title": "Home",
      "href": "./"
    },
    1: {
      "title": "Our Team",
      "href": "our-team.html"
    },
    2: {
      "title": 'Our Team Member'
    }
  })

  //- Julien Miro
  section.section-50.section-md-75.section-xl-100.bg-default
    .container
      .row.row-40.justify-content-md-center.justify-content-lg-start
        .col-md-6.col-lg-6
          .thumbnail.thumbnail-profile
            .thumbnail-image
              +jpg('profile-1-570x570')

        .col-md-6.col-lg-6.offset-xl-1.col-xl-5.text-md-start
          h4 Carl Williams
          p.text-uppercase.text-primary.text-spacing-50.small.offset-top-0 president and owner

          h5.text-spacing-0 One of the leading professionals in mortgage and loan solutions industry

          ul.list-inline.list-inline-0
            li
              span.icon.icon-sm.text-warning.mdi.mdi-star
            li
              span.icon.icon-sm.text-warning.mdi.mdi-star
            li
              span.icon.icon-sm.text-warning.mdi.mdi-star
            li
              span.icon.icon-sm.text-warning.mdi.mdi-star
            li
              span.icon.icon-sm.text-warning.mdi.mdi-star

          p.text-spacing-50.text-gray Carl began his career in the mortgage industry in 1996. He established FastCredit in 2001 and has become a top expert in the industry. Surrounding himself with true professionals who share the same beliefs and passions as he does is one of Carl’s top priorities. His unsurpassed success is a direct result of his dedication and commitment to the company’s clients. Carl’s clients became his friends, who refer their friends to us.
          .unit.flex-row.unit-spacing-xs.align-items-center.d-flex.contacts-link
            .unit-left
              span.icon.icon-xxs.icon-primary.material-icons-phone
            .unit-body
              a.link-default(href='callto:#') +1 (232) 349–8447
          .unit.flex-row.unit-spacing-xs.align-items-center.d-flex.contacts-link
            .unit-left
              span.icon.icon-xxs.icon-primary.fa-envelope
            .unit-body
              a.link-default(href='mailto:#') info@demolink.org
          a.btn.btn-small.btn-width.btn-primary(href='contact-us.html') get in touch
  ='\n'

  include ../sections/_section-counter-default

  //- Portfolio
  section.section-75.section-lg-100.bg-default
    .container.isotope-wrap
      .row.row-40
        .col-12.text-center
          h3 Carl’s Projects
          p.heading-subtext.text-gray.d-inline-block(style='max-width: 820px;') These are the latest and most successful mortgage projects by Carl Williams, our owner and founder. Pick the most appropriate for you or contact us for more information.

          //- Isotope Filters
          ul.isotope-filters-responsive
            li: p Choose your category:
            li.block-top-level
              //- Isotope Filters
              button.isotope-filters-toggle.btn.btn-sm.btn-default(data-custom-toggle='#isotope-1', data-custom-toggle-hide-on-blur='true')
                | Filter
                span.caret

              #isotope-1.isotope-filters.isotope-filters-minimal.isotope-filters-horizontal
                ul.list-inline
                  li
                    a.active(data-isotope-filter='*', data-isotope-group='gallery', href='#') all
                  li
                    a(data-isotope-filter='Category 1', data-isotope-group='gallery', href='#') Discount mortgages
                  li
                    a(data-isotope-filter='Category 2', data-isotope-group='gallery', href='#') Tracker mortgages
                  li
                    a(data-isotope-filter='Category 3', data-isotope-group='gallery', href='#') Offset mortgages


        .col-12
          .row.isotope.isotope-gutter-default(data-isotope-layout='fitRows', data-isotope-group='gallery', data-lightgallery='group')
              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
                +thumbnail-3({img: 'gallery-grid-1-370x278', original: 'original-667x1000_01'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
                +thumbnail-3({img: 'gallery-grid-2-370x278', original: 'original-1000x667_02'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
                +thumbnail-3({img: 'gallery-grid-3-370x278', original: 'original-1000x667_03'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
                +thumbnail-3({img: 'gallery-grid-4-370x278', original: 'original-1000x548_04'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
                +thumbnail-3({img: 'gallery-grid-5-370x278', original: 'original-1000x667_05'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
                +thumbnail-3({img: 'gallery-grid-6-370x278', original: 'original-1000x667_06'})
  ='\n'

  //- Page Footer
  include ../sections/_section-footer-default

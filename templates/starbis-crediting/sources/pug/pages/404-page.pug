extends  ../_skeleton

block variables
  - var pageName = '404 page'

block title
  title=pageName

block page
  section.section.section-single.novi-background.bg-gray-darker(style='background-image: url(images/bg-404.jpg);')

    .section-single-inner
      //-Page Header
      include ../sections/_section-header-base-transparent

      //- Page Main
      .section-single-main
        .container
          .row.justify-content-md-center
            .col-md-9.col-lg-8
              h5.text-spacing-50 Sorry, but the page was not found
              .text-extra-large-bordered
                p 404
              p.text-white.text-spacing-50.
                You may have mistyped the address or the page may have moved.
              .group-xl
                a.btn.btn-primary(href='index.html') Back to home
                a.btn.btn-white-outline(href='contact-us.html') contact us

      //- Page Footer
      include ../sections/_section-footer-base-transparent
extends  ../_skeleton

//- Includes

block variables
  - var activeIndex = 3
  - var pageName = 'Search results'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title(pageName, 'bg-image-1', {
    0: {
      "title": "Home",
      "href": "./"
    },
    1: {
      "title": "Pages",
      "href": "#"
    },
    2: {
      "title": pageName
    }
  })

  //- Privacy Policy
  section.section-60.section-md-90.section-xl-bottom-120.bg-default
    .container
      .row.row-40.row-md-60.justify-content-lg-center
        .col-lg-10
          //- RD Search
          form.rd-search.rd-search-minimal(action="search-results.html", method="GET", data-search-live-count='15')
            .form-wrap
              label.form-label(for="rd-search-form-input-1")
                span.text-mobile search...
                span.text-default start typing and hit enter
              input#rd-search-form-input-1.form-input(type="text" name="s" autocomplete="off")
            button.btn-icon-only.btn-icon-only-primary(type='submit')
              span.icon.icon-sm.material-icons-keyboard_return

        .col-md-11
          .rd-search-results
  ='\n'


  //- Page Footer
  include ../sections/_section-footer-default
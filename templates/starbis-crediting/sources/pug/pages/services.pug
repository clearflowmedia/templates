extends  ../_skeleton

//- Includes
include ../elements/_ui-icon-box-vertical
include ../elements/_ui-link-image
include ../elements/_ui-icon-box

block variables
  - var activeIndex = 1
  - var pageName = 'Services'

block title
  title=pageName

block page

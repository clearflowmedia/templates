  include ../sections/_section-default-cta

  section.bg-default
    .container
      .row
        .col-lg-6.section-75.section-lg-100.text-lg-start
          h2 Mortgage Advice
          h5.text-spacing-50 We provide personalized mortgage services.
          p.text-spacing-50.text-gray  Arranging a mortgage is one of the largest commitments most of us will ever make, even more reason to seek suitable mortgage advice which is individually tailored to your needs and requirements.

          p.text-spacing-50.text-gray  FastCredit is not tied to any specific lender, which means we can establish and recommend the best mortgage product. Our aim is to provide you with tailored and honest advice to help guide you through difficult decisions.
          a(href='#').btn.btn-primary.btn-width read more
        .col-lg-6.d-none.d-lg-block.align-self-lg-end
          img(src="images/services-01.jpg", width="430", height="595", alt="").img-responsive.center-block

  // Material Parallax
  +parallax({
    img: 'bg-services',
    addClass: 'bg-black'
  })
    .section-75.section-lg-100.context-dark
      .container
        h3.text-spacing-50 Mortgage News and Updates
        p.heading-subtext.text-spacing-0 Sign up to our newsletter and be the first to know about latest news,
          br.d-none.d-lg-block
          | special offers, events, and discounts from our company.
        a(href='contact-us.html').btn.btn-width.btn-white subscribe

  //- Page Footer
  include ../sections/_section-footer-default
extends  ../_skeleton

include ../_includes/_countdown

block variables
	- var pageName = 'Coming soon'

block title
	title=pageName

block page
	section.section.section-single.novi-background.bg-gray-darker(style='background-image: url(images/bg-coming-soon.jpg);')
		.section-single-inner
			//- Page Header
			include ../sections/_section-header-base-transparent

			//- Page Content
			.section-single-main
				.container
					.row.row-40.row-lg-60.justify-content-md-center
						.col-md-12
							h3.text-spacing-50.text-white
								| We're Getting Ready
								br
								| to Launch in
							.countdown-box.block-centered
								//- DateCountdown
								+countdown({to: '2024-01-22'})

							p.text-spacing-50.text-white
								| Our website is under construction, we are working very hard
								br.d-none.d-sm-block
								|  to give you the best experience on our new web site.

						.col-md-10.col-lg-9.col-xl-8
							h4.text-spacing-50 Stay ready, We`re Launching Soon
							//- RD Mailform
							form.rd-mailform.rd-mailform-inline(data-form-output="form-output-global", data-form-type='forms', method='post', action='bat/rd-mailform.php')
								.form-wrap
									label.text-white.form-label(for="inline-email") Enter your e-mail
									input#inline-email.form-input.form-input-transparent(type="email" name="email" data-constraints="@Email @Required")
								button(type="submit").btn.btn-white.btn-width subscribe

			//- Page Footer
			include ../sections/_section-footer-base-transparent
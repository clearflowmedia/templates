.row.row-40.align-items-md-end
  .col-md-6.col-xl-3
    //- Pricing table
    .pricing-table
      .pricing-table-header
        h5.pricing-table-title free
        .pricing-object.pricing-object-lg
          span.small.small-top $
          span.price 0
          span.small.small-bottom /mo
      .pricing-table-body
        ul.pricing-list.list-marked
          li FICO score
          li Years of credit
          li.list-item-disabled Education
          li.list-item-disabled Area of study
          li.list-item-disabled Job history
      .pricing-table-footer
        a.btn.btn-primary.btn-block(href='register.html') Sign up


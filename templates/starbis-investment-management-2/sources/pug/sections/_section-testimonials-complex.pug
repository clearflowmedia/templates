//- Include
include ../elements/_ui-quote-strict

//-Testimonials
section.section-top-60.section-md-top-90.bg-whisperapprox
  .container.text-center
    h3 Testimonials
    .row.row-offset-4.justify-content-md-center
      .col-md-11.col-lg-10.col-xl-8
        //-Slick Carousel
        .slick-carousel-complex-variant-1
          .slick-slider.slick-slider-images.slick-slider#child-carousel(data-for=".carousel-parent", data-arrows="false", data-loop="true", data-dots="false", data-swipe="true", data-items="1", data-sm-items='3', data-md-items='3', data-lg-items='3', data-xl-items='3', data-xxl-items='3', data-slide-to-scroll="1", data-center-mode="true", data-center-padding='0')
            .item
              +jpg('clients-testimonials-3-153x153')

            .item
              +jpg('clients-testimonials-4-153x153')

            .item
              +jpg('clients-testimonials-5-153x153')

            .item
              +jpg('clients-testimonials-6-153x153')

          .slick-slider.carousel-parent.slick-dots-variant-1(data-arrows="false", data-loop="true", data-dots="true", data-swipe="true", data-child="#child-carousel", data-for="#child-carousel", data-items="1", data-sm-items='1', data-md-items='1', data-lg-items='1', data-xl-items='1', data-slide-to-scroll="1", data-center-mode='true')
            .item
              +quote-strict({
                mod: 'quote-strict-inverse',
                text: "They are keeping their deadlines – often beating them – and are always available for advice. Their pricing is very attractive and their after sales service is second-to-none. They have created tremendous value for me and my clients. Definitely recommendable!",
                cite: "Mark Wilson"
              })

            .item
              +quote-strict({
                mod: 'quote-strict-inverse',
                text: "It has been a pleasure to work with InvestPlus and their team of investment experts. They offered me a quick and easy solution to my business investment strategy that will surely help me in handling my future spendings. I’m glad to cooperate with this qualified team.",
                cite: "Jack McGee"
              })

            .item
              +quote-strict({
                mod: 'quote-strict-inverse',
                text: "I have enjoyed a professional and fruitful relationship with InvestPlus for almost 6 years during which time, their knowledge, diligence, and focus to detail, has added greatly to my own company’s bottom-line, allowing me to offer enhanced benefits to my investors.",
                cite: "Gregory Smith"
              })

            .item
              +quote-strict({
                mod: 'quote-strict-inverse',
                text: "The team at InvestPlus can identify issues and try to provide solutions on all aspects of fund management and administration and will guide you with their in-depth knowledge whenever they are asked. Keep going this way!",
                cite: "Ann Williams"
              })

='\n'
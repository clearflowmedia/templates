.row.row-40.row-offset-3
  .col-md-6.col-lg-4.height-fill.wow.fadeInUp(data-wow-delay='0s')
    +icon-box({
      icon: ['icon-lg-bigger', 'material-icons-remove_red_eye', 'material-icons-device_hub'],
      textClass: 'text-gray-05',
      header: 'Market Research',
      text: 'Assessment of viability, stability and profitability of a business, sub-business or project.'
    })

  .col-md-6.col-lg-4.height-fill.wow.fadeInUp(data-wow-delay='.1s')
    +icon-box({
      icon: ['icon-lg-bigger', 'mercury-ico mercury-icon-partners'],
      textClass: 'text-gray-05',
      header: 'Investment Management',
      text: 'Our Investment Management Services help you pursue your financial needs as they grow and change.'
    })

  .col-md-6.col-lg-4.height-fill.wow.fadeInUp(data-wow-delay='.2s')
    +icon-box({
      icon: ['icon-lg-bigger', 'material-icons-supervisor_account'],
      textClass: 'text-gray-05',
      header: 'Sales & Trading',
      text: 'This service offers a variety of benefits to boost your sales and suit your company’s fixed income.'
    })
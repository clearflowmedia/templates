extends  ../_skeleton
include ../elements/_ui-progress-linear
include ../elements/_ui-countdown

block variables
	- var activeIndex = 2
	- var pageName = 'Progress Bars'

block title
	title=pageName

block page
	//-Page Header
	include ../sections/_section-header-default


	+page-title(pageName, 'bg-image-1')

	//-Skills Bars
	section.section-60.section-md-75.section-xl-bottom-120
		.container
			h3.text-center Skills Bars
			.row.row-40.row-offset-2.justify-content-lg-between.align-items-center
				.col-md-6.col-xl-5
					p.
						Our Investment Company, located in Rockville, Maryland, is a full service real estate company that provides acquisition, development and finance expertise for both commercial and multi-family projects.
					p.
						Our experience in structuring complicated financial transactions while accommodating diverse partnership interests, has allowed it to achieve over $1 Billion in acquisitions and financing.

				.col-md-6
					.progress-linear-group
						+progress-linear({
							title: 'Wealth Management',
							value: '70'
						}).progress-linear-primary
						+progress-linear({
							title: 'Business Owners',
							value: '54'
						}).progress-linear-khaki
						+progress-linear({
							title: 'Insurance & Annuities',
							value: '87'
						}).progress-linear-navy
						+progress-linear({
							title: 'Cash & Credit',
							value: '90'
						}).progress-linear-dark-orange
	='\n'


	//- Parallax
	+parallax({
		img: 'bg-image-3',
		addClass: 'bg-black bg-overlay-dark-2'
	})
		.section-60.section-md-100
			//- Counters
			.container
				h3.text-center Counters
				.row.row-40.row-offset-1.align-items-sm-end
					.col-sm-6.col-md-3.wow.fadeIn(data-wow-delay='.1s')
						.box-counter
							span.icon.icon-11
							//-CountTo
							.text-large.counter 1450
							h5.box-header Trusted Clients

					.col-sm-6.col-md-3.wow.fadeIn(data-wow-delay='.2s')
						.box-counter
							span.icon.icon-12
							//-CountTo
							.text-large.counter 18
							h5.box-header Awards

					.col-sm-6.col-md-3.wow.fadeIn(data-wow-delay='.3s')
						.box-counter
							span.icon.icon-13
							//-CountTo
							.text-large.counter 21
							h5.box-header Years of Experience

					.col-sm-6.col-md-3.wow.fadeIn(data-wow-delay='.4s')
						.box-counter
							span.icon.icon-14
							//-CountTo
							.text-large.counter.counter-k 16
							h5.box-header Experts


	//-Progress Bars
	section.section-60.section-md-75.section-lg-top-100.section-lg-bottom-120
		.container.text-center
			h3 Progress Bars
			.countdown-box.block-centered
				//- Countdown
				+countdown({to: '2024-01-22'})

	='\n'

	//-Page Footer
	include ../sections/_section-footer-default
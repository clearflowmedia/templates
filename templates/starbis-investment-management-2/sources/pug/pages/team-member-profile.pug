extends  ../_skeleton

//- Includes
include ../elements/_ui-thumbnail-3
include ../elements/_ui-quote-default
include ../elements/_ui-progress-linear

block variables
	- var activeIndex = 2
	- var pageName = 'Team member profile'

block title
	title=pageName

block page
	//-Page Header
	include ../sections/_section-header-default

	+page-title('Our team member', 'bg-image-8')

	//-Julien Miro
	section.section-50.section-md-75.section-xl-100
		.container
			.row.row-40.justify-content-md-center.justify-content-lg-start
				.col-md-6.col-lg-6
					.thumbnail.thumbnail-profile
						.thumbnail-image
							+jpg('profile-1-570x570')
						.thumbnail-caption
							.thumbnail-caption-inner
								ul
									li
										.unit.flex-row.unit-spacing-xs.align-items-center
											.unit-left
												span.icon.icon-xxs.icon-black.material-icons-phone
											.unit-body
												a.link-black-v2(href='callto:#') + 123 098 890 76 56
									li
										.unit.flex-row.unit-spacing-xs.align-items-center
											.unit-left
												span.icon.icon-xxs.icon-black.fa-envelope-o
											.unit-body
												a.link-black-v2(href='mailto:#') info@demolink.org
								.btn-wrap
									a.btn.btn-small.btn-ebony-clay-outline(href='contacts.html') get in touch

				.col-md-6.col-lg-6.col-xl-5
					.inset-md-left-50.inset-lg-left-40.inset-xl-left-100
						h4 Neil Woodford
						p.offset-top-0 Head of Investment

						p Neil Woodford is one of the most respected fund managers in the UK. His disciplined, valuation-oriented approach has consistently delivered outstanding long-term performance.

					.quote-default-offset
						+quote-default('I am really happy to work at InvestPlus with the team of true investment professionals.')

					.inset-md-left-50.inset-lg-left-40.inset-xl-left-100
						p He was a pivotal part of the UK equities team for more than 26 years, fine-tuning his distinctive approach and making his mark on the investment industry. He was appointed a Commander of the Order of the British Empire.
						.progress-linear-group
							+progress-linear({
								title: 'Wealth Management',
								value: '70'
							}).progress-linear-primary
							+progress-linear({
								title: 'Business Owners',
								value: '54'
							}).progress-linear-khaki
							+progress-linear({
								title: 'Insurance & Annuities',
								value: '87'
							}).progress-linear-navy
							+progress-linear({
								title: 'Cash & Credit',
								value: '90'
							}).progress-linear-dark-orange
	='\n'

	//-Portfolio
	section.section-50.section-md-90.section-xl-top-120.section-xl-bottom-145.bg-whisperapprox
		.container.isotope-wrap
			.row.row-40
				.col-12.text-center
					h3 Neil’s Projects
					p.d-inline-block(style='max-width: 820px;') In Neil’s portfolio, there are hundreds of successful projects and dozens of satisfied customers. Most of the companies he’s been working with became more profitable than ever before. Check out the gallery to learn more about his professional skills.


					//-Isotope Filters
					ul.isotope-filters-responsive
						li: p Choose your category:
						li.block-top-level
							//-Isotope Filters
							button.isotope-filters-toggle.btn.btn-sm.btn-default(data-custom-toggle='#isotope-1', data-custom-toggle-hide-on-blur='true')
								| Filter
								span.caret

							#isotope-1.isotope-filters.isotope-filters-minimal.isotope-filters-horizontal
								ul.list-inline
									li
										a.active(data-isotope-filter='*', data-isotope-group='gallery', href='#') All
									li
										a(data-isotope-filter='Category 1', data-isotope-group='gallery', href='#') Retirement & College Savings
									li
										a(data-isotope-filter='Category 2', data-isotope-group='gallery', href='#') Insurance & Annuities
									li
										a(data-isotope-filter='Category 3', data-isotope-group='gallery', href='#') Cash & Credit


				.col-12
					.row.isotope.isotope-gutter-default(data-isotope-layout='fitRows', data-isotope-group='gallery', data-lightgallery='group')
						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
							+thumbnail-3({img: 'gallery-grid-1-370x247', original: 'gallery-1-1200x800_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
							+thumbnail-3({img: 'gallery-grid-2-370x247', original: 'gallery-2-1200x800_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
							+thumbnail-3({img: 'gallery-grid-3-370x247', original: 'gallery-3-1200x800_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
							+thumbnail-3({img: 'gallery-grid-4-370x247', original: 'gallery-4-1200x800_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
							+thumbnail-3({img: 'gallery-grid-5-370x247', original: 'gallery-5-1200x800_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
							+thumbnail-3({img: 'gallery-grid-6-370x247', original: 'gallery-6-1200x800_original'})
	='\n'

	//-Page Footer
	include ../sections/_section-footer-default

extends  ../_skeleton

//- Includes
include ../sections/_section-header-default
include ../elements/_icon-box-vertical
include ../elements/_link-image

block variables
	- pageName = 'Services'

block page
	//- Page Header
	+header-default

	//- Page Content
	+page-title(pageName, 'bg-image-8')

	//- What We Do
	section.bg-primary
		.section-66.section-md-90
			.container
				h3.text-center What We Offer
				p.block-centered.text-center(style='max-width: 540px;') We will take care of your web design project regardless of its level of complexity. We are not afraid of difficult tasks – hundreds of our satisfied clients can prove that.

				.row.row-50.row-xl-60
					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-phonelink'],
							header: 'Internet Access',
							text: 'Eveniet illum laborum molestiae mollitia necessitatibus nesciunt repellendus sunt.'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-thumb_up'],
							header: 'Photocopying',
							text: 'Numquam odio optio quaerat quam quibusdam reiciendis sed sunt unde velit voluptas? Commodi dignissimos eligendi.'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-collections'],
							header: 'Coffee Shop',
							text: 'Eveniet explicabo fugit harum impedit ipsa ipsum minima minus molestiae nobis non nulla.'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-loop'],
							header: 'Coworking Space',
							text: 'A accusamus aliquam at blanditiis commodi corporis cumque, dicta distinctio dolorem dolores eligendi enim et'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-layers'],
							header: 'Regular Events',
							text: 'Aliquam aliquid blanditiis, eaque eius omnis pariatur quae ratione rerum tempora.'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-note_add'],
							header: 'Gaming Tournaments',
							text: 'Consectetur adipisicing elit. Ducimus officiis repellat sit temporibus voluptatem!'
						})


	include ../sections/_section-why-choose-us

	//- Our Clients
	section.section.section-60.section-md-90.section-xl-bottom-120.bg-primary.novi-background
		.container
			h3 Our Clients
			.row.row-40.offset-top-2
				.col-md-7.col-lg-5.col-xl-4
					//- Owl Carousel
					.owl-carousel-wrap
						.owl-carousel.owl-nav-bottom-left(data-autoplay='true', data-items='1', data-stage-padding='0', data-loop='true', data-margin='30', data-mouse-drag="false", data-nav='true')
							.item
								p Assumenda aut dolor doloribus esse excepturi molestiae officiis quis sit ut vel! At culpa deleniti dolorum ipsam.
							.item
								p Maxime modi perferendis ratione reiciendis repudiandae tempora velit veritatis voluptas voluptate.
							.item
								p Mollitia nisi totam voluptates voluptatibus. Aperiam aspernatur deleniti, dolorem esse illum incidunt.

				.col-lg-7.col-xl-8
					.row.row-30.shift-md-top-1
						.col-sm-6.col-md-3
							+link-image({img: 'services-2-132x83.png'})

						.col-sm-6.col-md-3
							+link-image({img: 'services-3-169x68.png'})

						.col-sm-6.col-md-3
							+link-image({img: 'services-4-141x88.png'})

						.col-sm-6.col-md-3
							+link-image({img: 'services-5-138x55.png'})


	//- Pricing tables
	section.section.bg-decoration-wrap.bg-decoration-bottom.bg-decoration-bottom-mod.section-60.section-md-100.bg-whisper
		.container.bg-decoration-content
			.row.row-40.justify-content-md-center
				.col-lg-10.col-xl-12
					h3 Choose Your Plan
				.col-lg-10.col-xl-12
					include ../includes/_pricing-tables-range
		.bg-decoration-object.bg-iron


	include ../sections/_section-default-cta


	//- Page Footer
	include ../sections/_section-footer-default

- var fonts = "//fonts.googleapis.com/css?family=Roboto:100,300,400,500,700%7CPlayfair+Display:400,700,700i,900,900i"
- var html_class = "wide wow-animation font-size-default"

include _mixins
include _config

block variables

doctype html

html(lang="en" class=html_class)
	head
		//- Site Title
		block title
			title Home

		meta(name="format-detection" content="telephone=no")
		meta(name="viewport" content="width=device-width, height=device-height, initial-scale=1.0, maximum-scale=1.0, user-scalable=0")
		meta(http-equiv="X-UA-Compatible" content="IE=edge")
		meta(charset='utf-8')

		link(rel="icon" href="images/favicon.png" type="image/x-icon")

		//- Stylesheets
		link(rel="stylesheet" type="text/css" href=fonts)
		link(rel="stylesheet" href="css/bootstrap.css")
		link(rel="stylesheet" href="css/fonts.css")
		link(rel="stylesheet" href="css/style.css")

		= "\n\t\t"

	body(class=bodyClass, style=typeof(bodyImage) == 'undefined' ? '' : 'background-image: url(images/' + bodyImage + '.jpg);')
		//- Page
		.preloader
			.preloader-body
				.cssload-container: .cssload-speeding-wheel
				p Loading...

		.page
			block page

			// Modal
			#appointment.modal.fade(tabindex='-1', role='dialog', aria-labelledby='appointment', aria-hidden='true')
				.modal-dialog.modal-lg.modal-dialog-centered(role='document')
					.modal-content.bg-whisper
						.modal-header
							h3 Get in #[span.text-thin Touch]
							button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close')


						.modal-body
							//- RD Mailform
							form.rd-mailform(data-form-output="form-output-global", data-form-type='contact', method='post', action='bat/rd-mailform.php')
								.row.row-30
									.col-md-6
										.form-wrap
											input#feedback-2-first-name.form-input(type="text" name="first-name" data-constraints="@Required")
											label.form-label(for="feedback-2-first-name") First Name
									.col-md-6
										.form-wrap
											input#feedback-2-last-name.form-input(type="text" name="last-name" data-constraints="@Required")
											label.form-label(for="feedback-2-last-name") Last Name

									.col-md-6
										.form-wrap
											input#feedback-2-email.form-input(type="email" name="email" data-constraints="@Email @Required")
											label.form-label(for="feedback-2-email") Email
									.col-md-6
										.form-wrap
											input#feedback-2-phone.form-input(type="text" name="phone" data-constraints="@Numeric @Required")
											label.form-label(for="feedback-2-phone") Phone
									.col-md-6
										.form-wrap
											input#feedback-date.form-input(type="text" name="date" data-constraints="@Required", data-time-picker='date')
											label.form-label(for="feedback-date") Date
									.col-md-6
										.form-wrap
											input#feedback-time.form-input(type="text" name="time" data-constraints="@Required", data-time-picker='time')
											label.form-label(for="feedback-time") Time Interval
									.col-sm-12
										.form-wrap
											textarea#feedback-2-message.form-input(name="message" data-constraints="@Required")
											label.form-label(for="feedback-2-message") Message
									.col-md-6
										button(type="submit").btn.btn-primary-outline.btn-block Send

			// Modal
			#sign-up.modal.fade(tabindex='-1', role='dialog', aria-labelledby='sign-up', aria-hidden='true')
				.modal-dialog.modal-sm.modal-dialog-centered(role='document')
					.modal-content.bg-whisper
						.modal-header
							p.text-uppercase.text-abbey.fw-bold.
								Choose your plane
							button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close')
						.modal-body
							//- RD Mailform
							form.rd-mailform
								.block-inner
									.form-wrap
										input#register-form-name.form-input(type="text" name="name" data-constraints="@Required")
										label.form-label(for="register-form-name") Name
									.form-wrap
										input#feedback-email.form-input(type="email" name="email" data-constraints="@Email @Required")
										label.form-label(for="feedback-email") Email
									.form-wrap
										input#feedback-phone.form-input(type="text" name="phone" data-constraints="@Numeric @Required")
										label.form-label(for="feedback-phone") Phone
									.form-wrap
										textarea#feedback-message.form-input(name="message" data-constraints="@Required")
										label.form-label(for="feedback-message") Message
									.form-wrap
										select.form-input.select-filter(data-placeholder='Select your plane' data-minimum-results-for-search="Infinity", data-constraints="@Required")
											option(label='placeholder')
											option(value="Free") Free - 0$
											option(value="Starter") Starter - 59$
											option(value="Business") Business - 99$
											option(value="Ultimate") Ultimate - 199$

								button(type="submit").btn.btn-primary.btn-block Send

		//- Global Mailform Output
		#form-output-global.snackbars


		//- Javascript
		script(src='js/core.min.js')
		script(src='js/script.js')
		// coded by gel

extends  ../_skeleton
include  ../elements/_ui-countdown

block variables
	- var pageName = 'Coming Soon'

block title
	title=pageName

block page
	section.section.section-single.novi-background.bg-gray-darker.novi-background(style='background-image: url(images/bg-image-8.jpg);')
		.section-single-inner
			//- Page Header
			include ../sections/_section-header-base-transparent

			//- Page Main
			.section-single-main
				.container
					.row.justify-content-md-center.row-40.row-xl-80
						.col-md-12
							h3.h3-variant-2.fw-bold
								| We're Getting Ready
								br
								| to Launch in
							.row.context-dark
								.col-sm-12
									.countdown-box.block-centered
										//- Countdown
										+countdown({to: '2024-01-22',mod: 'countdown-secondary'})

							p.text-white(style='opacity: 0.8;')
								| Our website is under construction, we are working very hard
								br.d-none.d-sm-block
								|  to give you the best experience on our new web site.

						.col-md-6.col-lg-5.col-xl-4
							h5 Stay ready, we`re launching soon
							//- RD Mailform
							form.rd-mailform.form-modern.form-inverse(data-form-output="form-output-global", data-form-type='subscribe', method='post', action='bat/rd-mailform.php')
								.form-wrap
									label.form-label(for="maintenance-email") Email
									input#maintenance-email.form-input(type="email" name="maintenance-email" data-constraints="@Email @Required")
								button(type="submit").btn.btn-primary.btn-block Subscribe
			='\n'

			//- Page Footer
			include ../sections/_section-footer-base-transparent
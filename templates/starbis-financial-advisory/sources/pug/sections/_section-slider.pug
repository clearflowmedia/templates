//- Swiper
section
  .swiper-container.swiper-slider.swiper-variant-1.bg-gray-base.context-dark(data-loop='true' data-autoplay='5500', data-simulate-touch='false')
    .swiper-wrapper
      .swiper-slide(data-slide-bg='images/home-slider-1-slide-1.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-md-center.justify-content-xl-start
              .col-md-11.col-lg-10.col-xl-6
                h2.slider-header(data-caption-animate='fadeInLeftSmall') We Provide Proper Tax Solutions 
                .slider-text(data-caption-animate='fadeInLeftSmall', data-caption-delay='100s')
                  p.text-big-22.text-white.font-accent.fw-light Affordable tax advisory services for your benefit
                .slider-button(data-caption-animate='fadeInLeftSmall', data-caption-delay='200s')
                  a.btn.btn-icon.btn-icon-right.btn-san-juan(href='appointment.html')
                    span.icon.icon-xxs-smaller.fa-angle-right
                    | Make An Appointment
 
      .swiper-slide(data-slide-bg='images/home-slider-1-slide-2.jpg')
        .swiper-slide-caption
          .container
           .row.justify-content-md-center.justify-content-xl-start
             .col-md-11.col-lg-10.col-xl-6 
                h2.slider-header(data-caption-animate='fadeInLeftSmall') Tax Compliance & Reporting
                .slider-text(data-caption-animate='fadeInLeftSmall', data-caption-delay='100s')
                  p.text-big-22.text-white.font-accent.fw-light Ensuring that tax and process risks are minimized
                .slider-button(data-caption-animate='fadeInLeftSmall', data-caption-delay='200s')
                  a.btn.btn-icon.btn-icon-right.btn-san-juan(href='appointment.html')
                    span.icon.icon-xxs-smaller.fa-angle-right
                    | Make An Appointment
 
      .swiper-slide(data-slide-bg='images/home-slider-1-slide-3.jpg')
        .swiper-slide-caption
          .container
           .row.justify-content-md-center.justify-content-xl-start
             .col-md-11.col-lg-10.col-xl-6
                h2.slider-header(data-caption-animate='fadeInLeftSmall') Tax Strategy Management
                .slider-text(data-caption-animate='fadeInLeftSmall', data-caption-delay='100s') 
                  p.text-big-22.text-white.font-accent.fw-light Improving the effectiveness of your tax strategy
                .slider-button(data-caption-animate='fadeInLeftSmall', data-caption-delay='200s')
                  a.btn.btn-icon.btn-icon-right.btn-san-juan(href='appointment.html')
                    span.icon.icon-xxs-smaller.fa-angle-right
                    | Make An Appointment

    //- Swiper Navigation
    .swiper-scrollbar.d-xl-none
    .swiper-nav-wrap.d-none.d-xl-block
      .swiper-button-prev
      .swiper-button-next

='\n'

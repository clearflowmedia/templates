//- Swiper
section.swiper-container.swiper-slider.swiper-variant-1.bg-black(data-loop='false' data-autoplay='4000' data-simulate-touch='true')
	.swiper-wrapper.text-center
		.swiper-slide(data-slide-bg='images/home-slider-1-slide-1.jpg')
			.swiper-slide-caption
				.container
					.row.justify-content-md-center
						.col-md-11.col-lg-10.col-xl-9
							h2.slider-header(data-caption-animate='fadeInUp', data-caption-delay='0s') Welcome to Starbis
							p.text-bigger.slider-text(data-caption-animate='fadeInUp', data-caption-delay='100') The smartest and most flexible Bootstrap template by Zemez you've ever seen. Create exactly what you need with our powerful Bootstrap toolkit.
							.group-xl-responsive
								a.btn.btn-xl.btn-white-outline-variant-1(data-caption-animate='fadeInUp', data-caption-delay='250', href='#', data-custom-scroll-to='section-start-journey') Start a journey
								a.btn.btn-xl.btn-primary-contrast(data-caption-animate='fadeInUp', data-caption-delay='250', href= links.getTemplate, target='_blank' ) Get starbis now

		.swiper-slide(data-slide-bg='images/home-slider-1-slide-2.jpg')
			.swiper-slide-caption
				.container
					.row.justify-content-md-center
						.col-md-11.col-lg-10.col-xl-9
							h2.slider-header(data-caption-animate='fadeInUp', data-caption-delay='0s') Unlimited Opportunities
							p.text-bigger.slider-text(data-caption-animate='fadeInUp', data-caption-delay='100') Starbis is the easiest way for you to build different sites without using many themes. Everything you need is combined in a single template.
							.group-xl-responsive
								a.btn.btn-xl.btn-white-outline-variant-1(data-caption-animate='fadeInUp', data-caption-delay='250', href='#', data-custom-scroll-to='section-start-journey') Start a journey
								a.btn.btn-xl.btn-primary-contrast(data-caption-animate='fadeInUp', data-caption-delay='250', href= links.getTemplate, target='_blank' ) Get starbis now

		.swiper-slide(data-slide-bg='images/home-slider-1-slide-3.jpg')

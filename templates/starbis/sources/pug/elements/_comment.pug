//- Comment
mixin comment(obj)
	//- Comment
	article.comment
		.unit.unit-spacing-md.flex-column.flex-sm-row
			.unit-left
				figure: +img(obj.img)

			.unit-body
				.comment-body
					.comment-body-header
						.comment-meta
							p.user=obj.user

							ul.list-inline.list-icon-meta
								li: a.link-group.link-group-baseline(href='#')
									span.novi-icon.icon.icon-xxs-smaller.icon-dusty-gray.mdi.mdi-thumb-up-outline
									span Like

								li: a.link-group(href='#')
									span.novi-icon.icon.icon-xxs-smaller.icon-dusty-gray.mdi.mdi-comment-outline
									span Reply

						.comment-time: .object-inline
							time(datetime='2024-01-16') Jan 16, 7:42 PM
							span.novi-icon.icon.icon-xxs-smaller.icon-dusty-gray.mdi.mdi-clock

					.comment-body-text: p=obj.text

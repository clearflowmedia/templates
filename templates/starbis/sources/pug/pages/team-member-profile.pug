extends  ../_skeleton

//- Includes
include ../elements/_thumbnail-3
include ../elements/_quote-default
include ../elements/_progress-linear

block variables
	- pageName = 'Team member profile'

block page
	//- Page Header
	include ../sections/_section-header-default

	//- Page Content
	+page-title('Our team', 'bg-image-6')

	//- Julien Miro
	section.section.section-50.section-md-75.section-xl-100
		.container
			.row.row-40.justify-content-md-center.justify-content-lg-start
				.col-md-6
					.thumbnail.thumbnail-profile
						.thumbnail-image
							+img('profile-1-570x570')
						.thumbnail-caption
							.thumbnail-caption-inner
								ul
									li
										.unit.unit-spacing-xs.align-items-center
											.unit-left: span.novi-icon.icon.icon-xxs.icon-black.material-icons-phone
											.unit-body
												a.link-black-v2(href='tel:#') +1 (232) 349–8447
									li
										.unit.unit-spacing-xs.align-items-center
											.unit-left: span.novi-icon.icon.icon-xxs.icon-black.fa-envelope-o
											.unit-body
												a.link-black-v2(href='mailto:#') info@demolink.org
								.btn-wrap
									a.btn.btn-small.btn-black-outline(href='contact-us.html') get in touch

				.col-md-6.col-lg-6.col-xl-5
					.inset-md-left-50.inset-lg-left-40.inset-xl-left-100
						h4 Julien Miro
						p.offset-top-0 Software Developer
						p Julien is our leading web developer who specializes in designing a website “from scratch”. He is responsible for building the essence of a website – its code.

					+quote-default('I can make any web design function flawlessly, trouble-free and as a single unit!')

					.inset-md-left-50.inset-lg-left-40.inset-xl-left-100
						p Web development and programming is what Julien is known for in our company. However, his area of interest also lies in other spheres of website building – from web design to online marketing or SEO.
						.progress-linear-group
							+progress-linear({
								title: 'HTML/CSS',
								value: '70'
							}).progress-linear-red
							+progress-linear({
								title: 'JavaScript',
								value: '54'
							}).progress-linear-blue
							+progress-linear({
								title: 'Rails',
								value: '87'
							}).progress-linear-yellow
							+progress-linear({
								title: 'UI/UX',
								value: '90'
							}).progress-linear-green


	//- Portfolio
	section.section.section-50.section-md-90.section-xl-top-120.section-xl-bottom-145.bg-mine-shaft.novi-background
		.container.isotope-wrap.isotope-style-inverse
			.row.row-40
				.col-sm-12.text-center
					h3
						span Check out
						em Julien’s projects
					p.d-inline-block(style='max-width: 820px;') In his portfolio there are hundreds of successful projects and dozens of satisfied customers. Some of the websites he’s been working on became profitable startups with thousands of daily visitors. Check out the gallery to learn more about his skills and style.

					//- Isotope Filters
					ul.isotope-filters-responsive
						li: p Choose your category:
						li.block-top-level
							//- Isotope Filters
							button.isotope-filters-toggle.btn.btn-sm.btn-default(data-custom-toggle='#isotope-1', data-custom-toggle-hide-on-blur='true', data-custom-toggle-disable-on-blur='true')
								| Filter
								span.caret

							#isotope-1.isotope-filters.isotope-filters-minimal.isotope-filters-horizontal
								ul.list-inline
									li: a.active(data-isotope-filter='*', href='#') All
									li: a(data-isotope-filter='Category 1', href='#') Webdesign
									li: a(data-isotope-filter='Category 2', href='#') UI/UX
									li: a(data-isotope-filter='Category 3', href='#') Branding

				.col-sm-12
					.row.isotope.isotope-gutter-default( data-lightgallery='group', data-lg-thumbnail='false')
						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
							+thumbnail-3({img: 'gallery-grid-1-370x278', original: 'gallery-1-1200x900_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
							+thumbnail-3({img: 'gallery-grid-2-370x278', original: 'gallery-2-1200x978_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
							+thumbnail-3({img: 'gallery-grid-3-370x278', original: 'gallery-3-1200x606_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
							+thumbnail-3({img: 'gallery-grid-4-370x278', original: 'gallery-4-1200x713_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
							+thumbnail-3({img: 'gallery-grid-5-370x278', original: 'gallery-5-1200x900_original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
							+thumbnail-3({img: 'gallery-grid-6-370x278', original: 'gallery-6-1200x900_original'})


	//- Page Footer
	include ../sections/_section-footer-default

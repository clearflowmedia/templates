//- Post boxed
mixin post-boxed(obj)
  article.post-boxed
    .post-boxed-image
      +jpg(obj.img)

    .post-boxed-body
      .post-boxed-title
        a(href="blog-post.html")=obj.header
      .post-boxed-footer
        ul.post-boxed-meta
          li: time(datetime=obj.time[0])=obj.time[1]
          li
            span by
            a(href='#')=obj.user

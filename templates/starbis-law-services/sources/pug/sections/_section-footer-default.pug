//- Includes
include ../elements/_ui-post-preview

//- Footer Widget
footer.page-foot.bg-ebony-clay
  .section-40.section-md-75
    .container
      .row.justify-content-sm-center
        .col-sm-9.col-md-11.col-xl-12
          .row.row-50
            .col-md-6.col-lg-10.col-xl-3
              .inset-xl-right-20(style='max-width: 510px;')
                //- Brand
                a.brand(href='index.html')
                  +logo(true)
                p.
                  If you or your business is facing a legal
                  challenge that calls for sound advice and skilled representation, contact us today to arrange a free  consultation with an attorney.
                a.link.link-group.link-group-animated.link-bold.link-white(href="appointment.html")
                  span Free Consultation
                  span.novi-icon.icon.icon-xxs.icon-primary.fa.fa-angle-right

            .col-md-6.col-lg-4.col-xl-3
              p.h7 Recent Posts
              +post-preview({
                classes: ['post-preview-inverse'],
                img: 'post-preview-4-70x70',
                header: 'Help Us Make the Law Accessible for Everyone',
                time: ['2021-06-23', 'June 23, 2021 ']
              })

              +post-preview({
                classes: ['post-preview-inverse'],
                img: 'post-preview-5-70x70',
                header: 'Legal Documents Every Landlord Needs ',
                time: ['2021-06-23', 'June 20, 2021']
              })

            .col-md-6.col-lg-4.col-xl-3
              p.h7 Quick links
              .row(style='max-width: 270px;')
                .col-6
                  ul.list-marked-variant-2
                    li: a(href='index.html') Home
                    li: a(href='services.html') Services
                    li: a(href='careers.html') Careers
                    li: a(href='blog-classic.html') Blog

                .col-6
                  ul.list-marked-variant-2
                    li: a(href='about-us.html') About us
                    li: a(href='contact-us.html') Contacts
                    li: a(href='appointment.html') Appointment

            .col-md-6.col-lg-4.col-xl-3
              p.h7 Contact us
              address.contact-info.text-start
                .unit.unit-horizontal.unit-spacing-md.align-items-center
                  .unit-left
                    span.novi-icon.icon.icon-xs.icon-storm-gray.material-icons-phone
                  .unit-body
                    a.link-white(href='callto:#') +123 234 984 47 45

                .unit.unit-horizontal.unit-spacing-md.align-items-center
                  .unit-left
                    span.novi-icon.icon.icon-xs.icon-storm-gray.fa.fa-envelope-o
                  .unit-body
                    a.link-white(href='mailto:#') info@demolink.org

                .unit.unit-horizontal.unit-spacing-md
                  .unit-left
                    span.novi-icon.icon.icon-xs.icon-storm-gray.material-icons-place
                  .unit-body
                    a.link-white.d-inline(href='#')
                      | 6036 Richmond hwy,
                      br
                      | Alexandria, VA USA 22303
  .container
    hr

  .section-35
    .container.text-center
      .row.row-15.flex-md-row-reverse.justify-content-md-between.align-items-md-center
        .col-md-6.text-md-end
          .group-sm.group-middle
            p.font-italic.text-white Follow Us:
            ul.list-inline.list-inline-reset
              li: a.novi-icon.icon.icon-circle.icon-bright-gray-filled.icon-xxs-smaller.fa.fa-facebook(href='#')
              li: a.novi-icon.icon.icon-circle.icon-bright-gray-filled.icon-xxs-smaller.fa.fa-twitter(href='#')
              li: a.novi-icon.icon.icon-circle.icon-bright-gray-filled.icon-xxs-smaller.fa.fa-google-plus(href='#')

        .col-md-6.text-md-start
          p.rights.text-white
            span.copyright-year
            span &nbsp;&#169;&nbsp;
            span LawExpert.&nbsp;
            a.link-white-v2(href='privacy-policy.html') Privacy Policy
='\n'
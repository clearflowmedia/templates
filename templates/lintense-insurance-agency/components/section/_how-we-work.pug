include ../counter/_counter

// How We Work
section.section.section-lg.bg-transparent
	.container
		.row.row-30.justify-content-between
			.col-xl-5.col-md-6
				h2 Best insurances for everyone.
				h5.font-weight-bold At Lintense, we are ready to offer you what you or your business needs to avoid various risks.
			.col-md-6
				h5.pr-xl-5 We have been protecting individuals, families, and businesses from risks since 1870. Here are just some numbers and facts about us.
				.row.row-40
					.col-xs-6
						+counter-default({
							value: '1500',
							title: 'Satisfied customers'
						})
					.col-xs-6
						+counter-default({
							value: '10',
							postfix: '+',
							title: 'Insurance solutions'
						})
					.col-xs-6
						+counter-default({
							value: '150',
							title: 'Years of experience'
						})
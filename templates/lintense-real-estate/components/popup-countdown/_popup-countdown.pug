// Popup countdown
#popup-countdown.popup.popup-countdown.text-center.modal.modal-secondary.fade( tabindex='-1', role='dialog' )
	.modal-dialog( role='document' )
		.modal-content
			button.close( type='button', data-dismiss='modal', aria-label='Close' )
				span( aria-hidden='true' ) ×
			.modal-body
				.container
					.row.justify-content-center
						.col-sm-11.col-md-9.col-lg-6.col-xl-5
							.context-dark
								h2 Book Your
									br
									| Event Tickets
								p.mt-2 Reserve your tickets now to enjoy the best event of the year with special guests and unique activities.
							+countdown({ from: '2020-03-20', to: '2020-12-01' }).countdown-boxed
							a.btn.btn-rect.btn-primary.btn-nuka( href='#' ) Book Now
								span.btn-overlay

include ../advantage/_advantage
section#about.section.section-into.bg-image-1( style='background-image: url(images/bg-image-01.png);' )
	.container
		.row.row-30
			.col-md-6
				h1.fw-normal welcome to
					span.d-block.fw-bold lintense
					span.d-block.fw-bold.text-primary.text-stroke basketball
						br
						| academy
				.block.block-lg
					p We are an international sports organization providing services to athletes from all around the world, with a firm mission to help them achieve their goals.
				a.btn.btn-dot( href='#' ) Learn more
			.col-md-6.position-relative
				.box.box-img-1
					+img('home-01-765x820.png')

	section#why-us.section.section-inner.section-into.bg-transparent
		.container
			.row.row-10
				.col-xl-2.offset-bottom-sm-20.offset-bottom-md-30
					h6 Why us?
				.col-md-6.col-xl-5
					+advantage({
						img: 'training-70x70.svg',
						title: 'Training',
						text: 'Effective training from our professional coaches.'
					})
				.col-md-6.col-xl-5
					+advantage({
						img: 'authority-70x70.svg',
						title: 'Authority',
						text: 'We invite an independent referee to every game we organize.'
					})
				.col-md-6.col-xl-5.offset-xl-2
					+advantage({
						img: 'stopwatch-70x70.svg',
						title: 'Precision & timing',
						text: 'The players of our club learn to grasp the game faster.'
					})
				.col-md-6.col-xl-5
					+advantage({
						img: 'heart-70x70.svg',
						title: 'Team unity',
						text: 'Being a team player has a deeper sense in basketball.'
					})
				.col-md-6.col-xl-5.offset-xl-2
					+advantage({
						img: 'presentation-70x70.svg',
						title: 'Youth academy',
						text: 'A great training program for the younger players.'
					})
				.col-md-6.col-xl-5
					+advantage({
						img: 'trophy-70x70.svg',
						title: 'Championship',
						text: 'All our players get to take part in various major championships.'
					})


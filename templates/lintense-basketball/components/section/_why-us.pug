include ../advantage/_advantage
// WHY US
section.section.section-md.bg-transparent
	.container
		.row
			.col-xl-2
				h6 Why us?
			.col-md-6.col-xl-5
				+advantage({
					img: 'training-70x70.svg',
					title: 'Training',
					text: 'Effective training from our professional coaches.'
				})
			.col-md-6.col-xl-5
				+advantage({
					img: 'authority-70x70.svg',
					title: 'Authority',
					text: 'We invite an independent referee to every game we organize.'
				})
			.col-md-6.col-xl-5.offset-xl-2
				+advantage({
					img: 'stopwatch-70x70.svg',
					title: 'Precision & timing',
					text: 'The players of our club learn to grasp the game faster.'
				})
			.col-md-6.col-xl-5
				+advantage({
					img: 'heart-70x70.svg',
					title: 'Team unity',
					text: 'Being a team player has a deeper sense in basketball.'
				})
			.col-md-6.col-xl-5.offset-xl-2
				+advantage({
					img: 'presentation-70x70.svg',
					title: 'Youth academy',
					text: 'A great training program for the younger players.'
				})
			.col-md-6.col-xl-5
				+advantage({
					img: 'trophy-70x70.svg',
					title: 'Championship',
					text: 'All our players get to take part in various major championships.'
				})


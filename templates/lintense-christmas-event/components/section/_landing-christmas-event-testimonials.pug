include ../quote/_quote

// Testimonials
section#testimonials.section.section-lg.bg-transparent
	.container
		h2.text-center( data-animate!={ class: 'fadeInUp' } ) Testimonials
		.row.row-offset-md.row-30
			.col-md-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				+quote-boxed({
					text: 'Thank you for organizing the best event for kids and adults! It has been a wonderful experience of decorating our personal Christmas tree and talking to Santa. We’ll take part in this event next year, too!',
					img:  'persons/person-01-74x74.jpg',
					name: 'Kate Peterson',
					date: 'December 24, 2020'
				})
			.col-md-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				+quote-boxed({
					text: 'Christmas is a wonderful time of the year and your team just made it even better! Me and my family left the entertainment center with the best impressions and memories. Thank you!',
					img:  'persons/person-02-74x74.jpg',
					name: 'Emma Smith',
					date: 'December 24, 2020'
				})
			.col-md-6.col-lg-4( data-animate!={ class: 'fadeInUp' } )
				+quote-boxed({
					text: 'I rode reindeer for the first time in my life and it has been amazing! Moreover, I bought lots of presents for my family during this event and I will undoubtedly come back next year.',
					img:  'persons/person-03-74x74.jpg',
					name: 'Amanda Wilson',
					date: 'December 24, 2020'
				})
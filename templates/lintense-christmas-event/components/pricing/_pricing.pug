//- Pricing
	@param {object} data.title - pricing title
	@param {object} data.price - pricing price per month
mixin pricing( data )
	// Pricing
	article.pricing&attributes( attributes )
		.pricing-title.h4!= data.title
		.pricing-price.h1
			span.pricing-price-prefix $
			span= data.price
		.pricing-list
			ul.list.list-mark-check.lead.d-inline-block.text-left
				each item in data.items
					li.list-item= item
		.pricing-btn
			a.btn.btn-lg.btn-nuka( href='#' ) Book Now!
				span.btn-overlay
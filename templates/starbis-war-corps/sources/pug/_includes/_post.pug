//- Post classic 1
    @param {object} data - thumbnail data object
    @param {string} data.title - post title
    @param {string} data.img - post image
    @param {string} [data.link] - post main link
    @param {string} [data.label] - post label
mixin post-classic-1( data )
    // Post classic
    .post&attributes( attributes )
        a.post-img-link( href= data.link ? data.link : 'blog-post.html' )
            +img( data.img )
        if (data.label)
            .post-meta
                .post-meta-item: a.post-meta-linkbox.post-meta-linkbox-sm.post-meta-linkbox-secondary( href= data.link ? data.link : 'blog-post.html' )= data.label
        h4.post-title: a( href= data.link ? data.link : 'blog-post.html' )= data.title

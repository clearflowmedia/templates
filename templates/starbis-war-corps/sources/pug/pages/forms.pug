extends  ../_skeleton

//- Includes
include ../sections/_section-header-default

block variables
	- var activeIndex = 3
	- pageName = 'Forms'

block page
	//- Page Header
	+header-default

	//- Page Content
	+page-title(pageName, 'bg-image-1')

	//- Forms
	section.section.section-40.section-md-bottom-30.section-md-top-90
		.container
			.row.text-center.text-md-start
				//- Login Form
				.col-md-7.col-lg-5.col-xl-4
					h3 Login Form

					//- Block shadow
					.block-shadow
						.block-inner
							p.h7 Log into your account
							span.novi-icon.icon.icon-xl.icon-black.material-icons-lock_open.block-icon

						//- RD Mailform
						form.rd-mailform.form-modern.form-darker.form-disabled
							.block-inner
								.form-wrap
									input#login-form-login.form-input(type="text" name="login" data-constraints="@Required")
									label.form-label(for="login-form-login") Login
								.form-wrap
									input#login-form-password.form-input(type="password" name="pass" data-constraints="@Required")
									label.form-label(for="login-form-password") Password
								.form-wrap
									a.link-default(href='#') Forgot your password?
							button(type="submit").btn.btn-primary.btn-round-bottom.btn-block Sign in

					.group-inline.text-center
						span Don’t have an account?
						a.link.link-primary-1(href='registration.html') Sign up here.

	//- Feedback Form
	section.section.section-30.section-md-bottom-100
		.container
			.row
				.col-lg-9.col-xl-7
					h3 Feedback Form
					form.rd-mailform.form-modern(data-form-output="form-output-global", data-form-type='order', method='post', action='bat/rd-mailform.php')
						.row.row-seven.row-30
							.col-md-3
								.form-wrap
									input#appointment-name.form-input(type="text" name="name" data-constraints="@Required")
									label.form-label(for="appointment-name") Name
							.col-md-4
								.form-wrap
									input#appointment-email.form-input(type="email" name="email" data-constraints="@Email @Required")
									label.form-label(for="appointment-email") Email
							.col-md-3
								.form-wrap
									input#appointment-date.form-input(type="text" name="date" data-constraints="@Required", data-time-picker='date')
									label.form-label(for="appointment-date") Date
							.col-md-4
								.form-wrap
									input#appointment-time.form-input(type="text" name="time" data-constraints="@Required", data-time-picker='time')
									label.form-label(for="appointment-time") Time Interval
							.col-sm-7
								.form-wrap
									.textarea-lined-wrap
										textarea#appointment-message.form-input(name="message" data-constraints="@Required")
										label.form-label(for="appointment-message") Message

							.col-7
								.row.row-seven.row-15
									.col-sm-6.col-md-5: button(type="submit").btn.btn-primary.btn-block Send
									.col-sm-6.col-md-4: button(type="reset").btn.btn-silver-outline.btn-block Reset



	//- Newsletter
	section.section.section-40.section-md-75
		.container
			.row
				.col-md-6.col-lg-5.col-xl-4
					h3 Newsletter
					//- RD Mailform
					form.rd-mailform.form-modern(data-form-output="form-output-global", data-form-type='subscribe', method='post', action='bat/rd-mailform.php')
						.form-wrap
							input#contact-email.form-input(type="email" name="email" data-constraints="@Email @Required")
							label.form-label(for="contact-email") Email
						button(type="submit").btn.btn-primary.btn-block Subscribe


	//- Mailchimp
	section.section.section-40.section-md-75.bg-whisper
		.container
			.row
				.col-md-6.col-lg-5.col-xl-4
					h3 MailChimp
					// Mailchimp
					form.rd-form.mailchimp-mailform.form-modern(data-form-output='form-output-global' action='https://templatemonster.us1.list-manage.com/subscribe/post?u=1e39a6d114a4cc130a4edbe43&id=9fc9ef194a' method='post')
						.form-wrap.form-wrap_icon.linear-icon-envelope
							label.form-label(for='mailchimp-email') Enter your e-mail
							input#mailchimp-email.form-input(type='email' name='email' data-constraints='@Email @Required')

						button.btn.btn-primary.btn-block(type='submit') Subscribe


	//- Campaign monitor
	section.section.section-40.section-md-75
		.container
			.row
				.col-md-6.col-lg-5.col-xl-4
					h3 Campaign Monitor
					//- RD Mailform
					form.rd-form.campaign-mailform.form-modern(data-form-output='form-output-global' action='https://templatermonster.createsend.com/t/j/s/zjjikd/' method='post')
						.form-wrap.form-wrap_icon.linear-icon-envelope
							label.form-label(for='campaign-email') Enter your e-mail
							input#campaign-email.form-input(type='email' name='cm-zjjikd-zjjikd' data-constraints='@Email @Required')

						button.btn.btn-primary.btn-block(type='submit') Subscribe

	.divider

	//- Page Footer
	include ../sections/_section-footer-default

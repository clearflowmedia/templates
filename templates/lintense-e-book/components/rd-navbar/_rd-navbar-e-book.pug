include ../logo/_logo
include _navigation

header.section.page-header
	//RD Navbar
	.rd-navbar-wrap.bg-primary
		nav.rd-navbar.rd-navbar-primary(
			data-rd-navbar= {
				responsive: {
					1200: { autoHeight: false }
				}
			}
		)
			.rd-navbar-main-outer
				.rd-navbar-main
					.rd-navbar-nav-wrap.rd-navbar-main-element-1
						+navigation( menu )

					//RD Navbar Panel
					.rd-navbar-panel
						//RD Navbar Toggle
						button.rd-navbar-toggle( data-rd-navbar-toggle='.rd-navbar-nav-wrap' ): span

						//RD Navbar Brand
						.rd-navbar-brand
							+logo

					.rd-navbar-collapse.rd-navbar-main-element-1.text-lg-right
						button.btn.btn-round.btn-nuka.text-primary( data-modal-trigger!={ target: '#modal' } ) Download
							span.btn-overlay
			.rd-navbar-collapse-toggle.rd-navbar-fixed-element-1( data-rd-navbar-toggle='.rd-navbar-collapse' ): span

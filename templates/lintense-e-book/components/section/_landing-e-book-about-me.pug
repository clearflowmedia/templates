// Author
section#author.section.section-lg.bg-transparent( style='padding-top: 7.4%;' )
	.container
		.row.row-50.justify-content-between
			.col-8.col-xs-6.col-md-4.col-lg-5
				.author.block.block-lg.block-center( style='margin-top: -13.4vw', data-animate!={ class: 'fadeInUp' } )
					+img( 'persons/person-01-420x470' ).author-image
					+img( 'image-01-294x167.png' ).author-signature.mt-0
			.col-md-7.col-lg-6( data-animate!={ class: 'fadeInUp' } )
				h1 Adam Smith
				p.lead Adam Smith was born in Boston, MA in 1985 to a family of an English teacher and car mechanic. Since his childhood, he’s been obsessed with reading books. He received the BA in Journalism in 1995 and had worked as a journalist in business magazines.
				p.lead His professional background proved to be useful when he decided to write his first book about the world of modern business, “Lintense”.
				.offset-md.group-30.d-flex.flex-wrap.align-items-center
					h4.text-primary Awards:
					div
						.group-30
							+img( 'awards/award-01-83x97.png' )
							+img( 'awards/award-02-83x97.png' )

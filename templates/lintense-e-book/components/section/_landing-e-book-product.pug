	.bg-layer.bg-100( style='top: 40%' )
	.container
		.row.justify-content-center
			.col-xs-8.col-lg-7
				+img( 'products/product-01-639x598.png' )( data-animate!={ class: 'fadeInUp' } )
				h1.mt-3( data-animate!={ class: 'fadeInUp' } ) Lintense: your #1 business guide

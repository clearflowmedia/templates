include ../thumbnail/_thumbnail

// Intro
section.intro.bg-100.novi-bg.novi-bg-image
	.intro-inner
		.row.row-30.align-items-center.row-fix
			.col-md-4.col-xxl-3.offset-xl-1.offset-xxl-2.text-center.text-md-left
				h1.intro-title
					span.font-weight-light Hi!
					span!= ' I\'m <br>a designer'
				h3.intro-subtitle ready to work on the next big project for your business
				a.btn( data-anchor-link, href='#contact' ) Get in touch

			.col-sm-6.col-md-5.col-lg-4.col-xxl-4
				+thumbnail-video({
					img: 'person-01-630x866'
				})

			.col-sm-5.col-md-3.col-xl-2
				+thumbnail-boxed({
					img: 'image-12-270x285',
					tags: [ 'Design' ],
					title: 'iStep Co.',
					text: 'A UX design project I have recently worked on.'
				})

			.col-md-6.col-lg-1.col-xxl-1.text-center.text-md-left
				.intro-social.h5
					a.intro-social-link( href='#' ) Instagram
					a.intro-social-link( href='#' ) Pinterest
		.intro-bg-text Boooo
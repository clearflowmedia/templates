include ../quote/_quote

// Clients
section#testimonials.section.section-md.bg-left.novi-bg.novi-bg-image
	.bg-item.bg-image.novi-bg.novi-bg-image( style='background-image:url( images/bg-pattern-1.jpg )', data-animate!={ class: 'fadeInLeftBig', delay: '.15s' } )
	.container
		.row.row-20.row-fix
			.col-md-6( data-animate!={ class: 'fadeInLeft' } )
				.swiper-separate-container
					.swiper-container( data-swiper!= {
						loop: true,
						autoplay: false,
						speed: 1000,
						spaceBetween: 30,
						autoHeight: true,
						direction:"vertical",
						navigation: {
							nextEl: '#swiper-separate-next',
							prevEl: '#swiper-separate-prev'
						}
					})
						.swiper-wrapper
							.swiper-slide
								+quote({
									quote: 'James spends quite a bit of time getting to know his clients and their projects to be able to add tremendous value to them.',
									authorImg: 'person-01-67x67',
									authorName: 'Emma Wilson',
									authorMeta: 'Client'
								})
							.swiper-slide
								+quote({
									quote: 'James is exceptionally talented and very well-versed in both design and web technologies. I highly recommend him.',
									authorImg: 'person-02-67x67',
									authorName: 'John McMillan',
									authorMeta: 'Client'
								})
							.swiper-slide
								+quote({
									quote: 'James is one of the most talented designers we\'ve had the opportunity to work with. His elegant design execution comes with great precision.',
									authorImg: 'person-03-67x67',
									authorName: 'Kate Peters',
									authorMeta: 'Client'
								})

					.swiper-separate-navigation
						button#swiper-separate-next.swiper-button.swiper-button-next.mdi-arrow-up
						.swiper-pagination
						button#swiper-separate-prev.swiper-button.swiper-button-prev.mdi-arrow-down


			.col-md-6.text-center.text-sm-left
				h2.text-decoration( data-animate!={ class: 'fadeIn' } ) My Clients
				h5( data-animate!={ class: 'fadeIn' } ) Read the testimonials submitted by my clients and partners. You can fully trust their opinions on my solutions.
				.row.row-30.row-xxl-50.row-content-2.align-items-center.text-center( data-animate!={ class: 'fadeIn' } )
					.col-xs-6.col-md-4: +img( 'logo-01-86x36.png' )
					.col-xs-6.col-md-4: +img( 'logo-02-187x30.png' )
					.col-xs-6.col-md-4: +img( 'logo-03-130x27.png' )
					.col-xs-6.col-md-4: +img( 'logo-04-123x28.png' )
					.col-xs-6.col-md-4: +img( 'logo-05-84x17.png' )
					.col-xs-6.col-md-4: +img( 'logo-06-104x23.png' )
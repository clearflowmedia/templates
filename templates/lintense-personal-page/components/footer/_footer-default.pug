include ../logo/_logo
include ../rights/_rights

footer.footer.context-dark.bg-800.novi-bg.novi-bg-image
	.footer-top
		.row.justify-content-center.justify-content-lg-start.row-fix
			.col-sm-6.col-xxl-5
				.image-social
					a.image-social-icon.mdi-facebook-messenger.novi-icon( href='#' )
					+img( 'image-11-787x516' ).image

			.col-md-10.col-lg-6.col-xl-5.col-xxl-3.offset-xxl-1
				.footer-inner
					+logo
					form.rd-form.rd-form-inline.rd-mailform( data-form-output='newsletter-sample', data-form-type='subscribe', method='post', action='components/rd-mailform/rd-mailform.php', data-animate!={ class: 'fadeInUp' } )
						.form-group
							input.form-control.form-control-sm( type='email', name='email', placeholder='E-mail', data-constraints='@Email @Required' )
						button.btn.btn-sm.btn-secondary( type='submit' ) Subscribe
					#newsletter-sample.form-output.snackbar.snackbar-primary
					.row.row-20.row-content
						.col-6.col-sm-4.col-xl-6( data-animate!={ class: 'fadeInUp' } )
							h5 E-mail
							p: a( href='mailto:#' ) info@demolink.org
						.col-6.col-sm-4.col-xl-6( data-animate!={ class: 'fadeInUp', delay: '.15s' } )
							h5 Phone
							p: a( href='tel:#' ) 800.567.1234
						.col-6.col-sm-4.col-xl-6( data-animate!={ class: 'fadeInUp' } )
							h5 Address
							p 121 King Street, Melbourne , Australia

	.footer-bottom
		.container
			.row.row-20( data-animate!={ class: 'fadeIn' } )
				.col-md-7.col-xl-6
					.group-80x15
						a.image-link( href='#' ): +img( 'logo-07-81x20.png' ).image
						a.image-link( href='#' ): +img( 'logo-08-102x20.png' ).image
						a.image-link( href='#' ): +img( 'logo-09-98x27.png' ).image
				.col-md-5.col-xl-6
					+rights
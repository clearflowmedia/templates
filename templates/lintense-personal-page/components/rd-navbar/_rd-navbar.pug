include _navigation

mixin rd-navbar
	//RD Navbar
	header.rd-navbar-wrap.rd-navbar-wrap-absolute( data-preset!={ title:'Navbar Default', category:'header', reload:true, id:'navbar-default' } )
		nav.rd-navbar&attributes( attributes )
			.navbar-container
				.navbar-cell.navbar-subpanel-contact
					.navbar-contact
						button.navbar-button.navbar-contact-btn( data-multi-switch!= {
							targets: '.rd-navbar',
							scope: '.rd-navbar',
							class: 'navbar-contact-active',
							isolate: '[data-multi-switch]:not( .navbar-button )'
						})
							span
						.navbar-contact-body
							.navbar-contact-title.h4 Join My Newsletter
							form.rd-form.rd-form-inline.rd-mailform( data-form-output='newsletter-navbar', data-form-type='subscribe', method='post', action='components/rd-mailform/rd-mailform.php' )
								.form-group
									input.form-control.form-control-sm( type='email', name='email', placeholder='E-mail', data-constraints='@Email @Required' )
								button.btn.btn-sm.btn-primary( type='submit' ) Subscribe
							#newsletter-navbar.form-output.snackbar.snackbar-primary

				.navbar-cell.navbar-cell-center
					.navbar-panel
						button.navbar-switch.mdi-menu.novi-icon( data-multi-switch!= {
							targets: '.rd-navbar',
							scope:   '.rd-navbar',
							isolate: '[data-multi-switch]'
						})

						.navbar-logo
							a.navbar-logo-link( href='index.html' )
								+img( logo.default, { retina: true } ).navbar-logo-default( alt= logo.name )
								+img( logo.inverse, { retina: true } ).navbar-logo-inverse( alt= logo.name )

					.navbar-sidebar
						+navigation( menu )

				.navbar-cell
					.navbar-subpanel
						.navbar-subpanel-item.navbar-subpanel-item-mobile
							button.navbar-button.navbar-contact-btn.mdi-dots-vertical( data-multi-switch!= {
								targets: '.rd-navbar',
								scope: '.navbar-subpanel-contact',
								class: 'navbar-contact-active',
								isolate: '[data-multi-switch]:not( .navbar-button )'
							})

						.navbar-subpanel-item
							a.navbar-social-icon.mdi-facebook-messenger.novi-icon( href='#' )

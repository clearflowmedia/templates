//- Swiper
section
  .swiper-container.swiper-slider.swiper-variant-1.bg-gray-base.context-dark(data-loop='true' data-autoplay='5500', data-simulate-touch='true')
    .swiper-wrapper.text-center
      .swiper-slide(data-slide-bg='images/home-slider-1-slide-1.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-md-center.justify-content-xl-start.text-xl-start
              .col-md-11.col-lg-10.col-xl-6
                h2.slider-header(data-caption-animate='fadeInUp', data-caption-delay='0s') Our Clients Don't Have Tax Problems
                .slider-text(data-caption-animate='fadeInUp', data-caption-delay='350s')
                  p.text-big-22.text-white.font-accent.fw-light Optimize tax costs using our years of experience
                .slider-button(data-caption-animate='fadeInUp', data-caption-delay='450s')
                  a.btn.btn-icon.btn-icon-right.btn-cello(href='appointment.html')
                    span.icon.icon-xs-smaller.fa-angle-right
                    | make An Appointment

      .swiper-slide(data-slide-bg='images/home-slider-1-slide-2.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-md-center
              .col-md-11.col-lg-10.col-xl-12
                h2.slider-header(data-caption-animate='fadeInUp', data-caption-delay='0s') We Provide Proper Tax Solutions
                .slider-text(data-caption-animate='fadeInUp', data-caption-delay='350s')
                  p.text-big-22.text-white.font-accent.fw-light Optimize tax costs using our years of experience
                .slider-button(data-caption-animate='fadeInUp', data-caption-delay='450s')
                  a.btn.btn-icon.btn-icon-right.btn-primary(href='appointment.html')
                    span.icon.icon-xs-smaller.fa-angle-right
                    | make An Appointment

    //- Swiper Navigation
    .swiper-scrollbar.d-xl-none
    .swiper-nav-wrap.d-none.d-xl-block
      .swiper-button-prev
      .swiper-button-next

='\n'

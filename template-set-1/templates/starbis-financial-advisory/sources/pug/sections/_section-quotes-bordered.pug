include ../elements/_ui-quote-bordered

//- What People Say
section.section.parallax-container.context-dark(data-parallax-img='images/clients-testimonials-parallax-3.jpg')
  .parallax-content
    .section-60.section-md-90.bg-overlay-cello
      .container.text-center
        .row
          .col-sm-12
            h3 What People Say

        .row.text-start
          .col-sm-12
            //- Owl Carousel
            .owl-carousel.owl-spacing-1.owl-nav-classic.owl-style-minimal(
            data-items="1" 
            data-sm-items="2"  
            data-stage-padding="15"   
            data-autoplay="true" 
            data-loop="true"
            data-margin="30" 
            data-mouse-drag="true" 
            data-nav="true"  
            data-dots="true" 
            data-dots-each="1"
            class="owl-carousel owl-spacing-1 owl-nav-classic owl-style-minimal")
              .item
                +quote-bordered({
                  img: 'clients-testimonials-1-68x68', 
                  header: 'Very professional team',
                  text: 'TaxAdvisor filed my tax returns for this year. They were very complicated as compared to any other due to a host of reasons. They handled my tax returns very professionally and accurately. I am pleased to recommend TaxAdvisor. ',
                  cite: 'Emily Wilson',
                  caption: 'Top Manager'
                })

              .item
                +quote-bordered({
                  img: 'clients-testimonials-2-68x68',
                  header: 'Very knowledgeable tax accountants',
                  text: "The services they offered me for this year's tax filing has been exemplary and of the highest class. I would recommend them for doing taxes. The service that they rendered was very timely and the fees for the service were reasonable.",
                  cite: 'Dennis Lewis',
                  caption: 'Civil Servant'
                })
='\n'

              h6.text-uppercase.text-big.footer-title About us
              p.text-san-juan Our firm has been providing expert tax and consulting services to individuals and small businesses throughout the country since 1989.
              
            .group-md.group-top
              div
                .unit.align-items-center.unit-horizontal.unit-spacing-xs
                  .unit-left: span.icon.icon-xs-smaller.icon-primary.fa-phone
                  .unit-body: a.link.link-bold.link-white-v2(href='tel:#') +1 (409) 987–5874
                  
                .inset-left-30
                  a.link-white-v2.text-italic(href='mailto:#') info@demolink.org
              div
                ul.list-inline.list-inline-reset
                  li: a.icon.icon-round.icon-san-juan-filled.icon-xxs-smallest.fa.fa-facebook(href='#')
                  li: a.icon.icon-round.icon-san-juan-filled.icon-xxs-smallest.fa.fa-twitter(href='#')
                  li: a.icon.icon-round.icon-san-juan-filled.icon-xxs-smallest.fa.fa-google-plus(href='#')


          .col-md-6.col-lg-4
            h6.text-uppercase.text-big.footer-title Quick links
            .row(style='max-width: 340px;')
              .col-6
                ul.list-marked-variant-2
                  li: a(href='index.html') Home
                  li: a(href='services.html') Services
                  li: a(href='careers.html') Careers
                  li: a(href='blog-classic.html') Blog

              .col-6
                ul.list-marked-variant-2
                  li: a(href='about-us.html') About us
                  li: a(href='contact-us.html') Contacts
                  li: a(href='appointment.html') Appointment

          .col-md-6.col-lg-4
            h6.text-uppercase.text-big.footer-title Subscribe
            p.text-san-juan Get the latest updates and offers.
            //- RD Mailform
            form.rd-mailform.form-classic.form-inline.offset-top-15(data-form-output="form-output-global", data-form-type='subscribe', method='post', action='bat/rd-mailform.php')
              .form-wrap
                input#contact-email.form-input(type="email" name="email" data-constraints="@Email @Required")
                label.form-label(for="contact-email") Enter Your E-mail
              button.btn.btn-icon-only.btn-primary(type="submit" aria-label='Subscribe')
                span.icon.icon-xs.icon-white.fa-envelope-o
='\n'

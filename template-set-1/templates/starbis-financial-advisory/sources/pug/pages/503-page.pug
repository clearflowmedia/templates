extends  ../_skeleton

block variables
  - var pageName = '503 Page'

block title
  title=pageName

block page
  section.section.section-single.novi-background.bg-gray-darker.novi-background(style='background-image: url(images/bg-image-10.jpg);')
    .section-single-inner
      //- Page Header
      include ../sections/_section-header-base-transparent
  
      //- Page Content
      .section-single-main
        .container
          .row.justify-content-md-center
            .col-md-9.col-lg-8
              h5 Service is temporary unavailable
              .text-extra-large-bordered
                p 503
  
              p.text-white
                | Sorry, we're offline right now to make our site even better.
                br.d-none.d-sm-block
                |  Please, come back later and check what we've been up to.
  
              .group-xl
                a.btn.btn-primary(href='index.html') Back to home
                a.btn.btn-white-outline(href='contact-us.html') contact us
  
      //- Page Footer
      include ../sections/_section-footer-base-transparent
				.col-sm-8.col-md-5.col-xl-3.wow.fadeInLeftSmall(data-wow-delay='.3s')
					//- Post Boxed
					.post-boxed.d-xl-inline-block
						a.post-boxed-img-wrap(href="blog-post.html")
							+jpg("home-4-268x182")

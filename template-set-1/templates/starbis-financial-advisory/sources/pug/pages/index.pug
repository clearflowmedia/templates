											span.fw-ubold 1
											| Databases
								.pricing-table-footer
									a.btn.btn-round-bottom.btn-cello.btn-block(href='register.html') Sign up

						.col-md-6.col-xl-3.wow.fadeInRightSmall(data-wow-delay='.1s')
							//- Pricing table
							.pricing-table
								.pricing-table-body
									h5.pricing-table-header Starter
									.pricing-object.pricing-object-lg
										span.small.small-top $
										span.price 59
										span.small.small-bottom /mo
									.divider-circle

									ul.pricing-list
										li
											span.fw-ubold 5GB
											| Space amount
										li
											span.fw-ubold 20
											| users
										li
											span.fw-ubold 20
											| Pages
										li No Support

										li
											span.fw-ubold 1
											| Databases
								.pricing-table-footer
									a.btn.btn-round-bottom.btn-cello.btn-block(href='register.html') Sign up

						.col-md-6.col-xl-3.wow.fadeInRightSmall(data-wow-delay='.2s')
							//- Pricing table
							.pricing-table.pricing-table-preferred
								.pricing-table-label
									p Most popular
								.pricing-table-body
									h5.pricing-table-header Business
									.pricing-object.pricing-object-lg
										span.small.small-top $
										span.price 99
										span.small.small-bottom /mo
									.divider-circle

									ul.pricing-list
										li
											span.fw-ubold 10GB
											| Space amount
										li
											span.fw-ubold Unlimited
											| users
										li
											span.fw-ubold 50
											| Pages
										li Free Support

										li
											span.fw-ubold 20
											| Databases
								.pricing-table-footer
									a.btn.btn-round-bottom.btn-cello.btn-block(href='register.html') Sign up

						.col-md-6.col-xl-3.wow.fadeInRightSmall(data-wow-delay='.3s')
							//- Pricing table
							.pricing-table
								.pricing-table-body
									h5.pricing-table-header Ultimate
									.pricing-object.pricing-object-lg
										span.small.small-top $
										span.price 199
										span.small.small-bottom /mo
									.divider-circle

									ul.pricing-list
										li
											span.fw-ubold 100GB
											| Space amount
										li
											span.fw-ubold Unlimited
											| users
										li
											span.fw-ubold 100
											| Pages
										li Free Support

										li
											span.fw-ubold Unlimited
											| Databases
								.pricing-table-footer
									a.btn.btn-round-bottom.btn-cello.btn-block(href='register.html') Sign up
		.bg-decoration-object.bg-whisper
	='\n'

	//- Latest News
	section.section-50.section-md-90.section-md-bottom-100.bg-white
		.container.text-center
			h3 Latest News

			.row.justify-content-sm-center.row-40
				.col-sm-8.col-md-5.col-xl-3.wow.fadeInLeftSmall

extends  ../_skeleton

//- Includes
include ../elements/_ui-icon-box-vertical
include ../elements/_ui-thumbnail-1
include ../elements/_ui-thumbnail-3
include ../elements/_ui-link-image
include ../elements/_ui-icon-box

block variables
	- var activeIndex = 0

block title
	title Home

block page
	//- Page Header
	include ../sections/_section-header-default
	include ../sections/_section-slider

	//- Page Content
	section.section-50.section-md-90.section-xl-bottom-120
		.container.text-center
			h3 Our Services
			p.text-big.font-accent.text-spacing-40 We provide expert tax and advisory services to individuals and small businesses.

			.row.justify-content-sm-center.row-50
				.col-sm-6.col-lg-3.wow.fadeInUpSmall
					+icon-box({
                        icon: ['icon-lg', 'fl-puppets-maths26'],
                        header: 'Bookkeeping',
                        text: 'We’ll create a chart of accounts to capture all your financial transactions.'
                    })

				.col-sm-6.col-lg-3.wow.fadeInUpSmall(data-wow-delay='0.1s')
					+icon-box({
                        icon: ['icon-lg', 'fl-puppets-chart6'],
                        header: 'Tax Planning',
                        text: 'Planning is the key to successfully and legally reducing your tax liability.'
                    })

				.col-sm-6.col-lg-3.wow.fadeInUpSmall(data-wow-delay='0.2s')
					+icon-box({
                        icon: ['icon-lg', 'fl-puppets-bank17'],
                        header: 'Bank Reconciliation',
                        text: 'Every deposit and withdrawal aligns with entries into your accounting records. '
                    })

				.col-sm-6.col-lg-3.wow.fadeInUpSmall(data-wow-delay='0.3s')
					+icon-box({
                        icon: ['icon-lg', 'fl-puppets-savings3'],
                        header: 'Property Taxes',
                        text: 'If you need help paying property tax, our tax specialists are here for you. '
                    })

	='\n'

	//- Our Benefits
	section.section.bg-image.section-top-75.section-bottom-65.section-md-100(style='background-image: url(images/home-6.jpg);')
		.container
			.row.row-40.g-0.justify-content-center.justify-content-md-end.align-items-center
				.col-sm-10.col-md-7.col-lg-6.col-xl-5(style="max-width:430px;")
					//- Box
					.box.bg-cello.section-relative
						h3 About Us
						p.wow.fadeIn We are dedicated to providing professional service with the highest degree of honesty and integrity, and strive to add value to our tax and consulting services.

						ul.list-marked
							li.wow.fadeInLeftSmall Highly Competent Professionals
							li.wow.fadeInLeftSmall(data-wow-delay='0.1s') Affordable Prices
							li.wow.fadeInLeftSmall(data-wow-delay='0.2s') High Successful Recovery

						.button-block.wow.fadeInUpSmall
							a.btn.btn-icon.btn-icon-right.btn-white-outline(href='appointment.html')
								span.icon.icon-xxs-smaller.fa-angle-right.text-primary
								| make An Appointment
				.col-sm-10.col-md-4.col-lg-3.col-xl-2.box-list-xs
					//- Counter Boxed
					.counter-boxed.box-xs.bg-cello.text-center
						//- CountTo
						.counter 23
						.offset-top-5
							p.text-san-juan.fw-sbold Consultants
					//- Counter Boxed
					.counter-boxed.box-xs.bg-cello.text-center
						//- CountTo
						.counter 546
						.offset-top-5
							p.text-san-juan.fw-sbold Happy Clients
					//- Counter Boxed
					.counter-boxed.box-xs.bg-cello.text-center
						//- CountTo
						.counter 17
						.offset-top-5
							p.text-san-juan.fw-sbold(style="line-height:1.2;") Years of Experience
	='\n'

	//- Tax Calculator
	section.bg-image.bg-image-md-inverse-transparent(style="background-image: url(images/home-5.jpg);")
		.bg-overlay-lighten-inverse-md
			.container.section-66.section-md-100
				.row.justify-content-sm-center.justify-content-md-start
					.col-md-10.col-lg-6
						.unit.align-items-center.unit-horizontal.unit-spacing-sm
							.unit-left: span.icon.icon-lg.fl-puppets-maths27.text-secondary
							.unit-body: h3 Tax Calculator

						form#form1.rd-mailform.row.justify-content-sm-center.justify-content-md-start.inset-xl-right-30.row-40.wow.fadeIn(data-form-output="form-output-global", method='post', action='bat/rd-mailform.php')
							.col-md-6
								.form-wrap.form-wrap-outside
									//Select 2
									select#index-business.form-input.select-filter(data-minimum-results-for-search="Infinity" )
										option(value="1") Retail
										option(value="2") All
									label.form-label.form-label-outside(for="index-business") Choose your business area
							.col-md-6
								.form-wrap.form-wrap-outside
									//Select 2
									select#index-residence.form-input.select-filter(data-minimum-results-for-search="Infinity")
										option(value="2") USA
										option(value="3") All
									label.form-label.form-label-outside(for="index-residence") Country of residence
							.col-md-6
								.form-wrap.form-wrap-outside
									//Select 2
									select#index-employees.form-input.select-filter(data-minimum-results-for-search="Infinity")
										option(value="2") 1-5
										option(value="3") 1-6
									label.form-label.form-label-outside(for="index-employees") Employees number
							.col-md-6
								.form-wrap.form-wrap-outside
									input#index-income.form-input.bg-whisper-lighten(type="text" name="name" data-constraints='@Required @Numeric')
									label.form-label.form-label-outside(for="index-income") Yearly Income
							.col-md-6
								.form-wrap.form-wrap-outside
									input#index-total.form-input.form-border-bottom.bg-whisper-lighten(type="text" name="name")
									label.form-label.form-label-outside(for="index-total") Total Payment
							.col-md-6
								.form-wrap.form-wrap-outside
									button.btn.btn-primary.btn-block(type="submit") Calculate


	='\n'

	include ../sections/_section-quotes-bordered

	//- Pricing tables
	section.bg-decoration-wrap.bg-decoration-bottom.section-60.section-xl-top-100.section-xl-bottom-100
		.container.bg-decoration-content
			.row.justify-content-md-center
				.col-lg-10.col-xl-12
					h3.text-center Pricing Plans
					.row.align-items-md-end.row-40
						.col-md-6.col-xl-3.wow.fadeInRightSmall
							//- Pricing table
							.pricing-table
								.pricing-table-body
									h5.pricing-table-header free
									.pricing-object.pricing-object-lg

//-Swiper
section
  .swiper-container.swiper-slider.swiper-variant-1.bg-black(data-loop='true', data-autoplay='5500', data-simulate-touch='true')
    .swiper-wrapper.text-center
      .swiper-slide.bg-overlay-dark(data-slide-bg='images/home-slider-1-slide-1.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-md-center
              .col-md-11.col-lg-10.col-xl-9
                .shilder-header-with-divider.d-none.d-lg-block(data-caption-animate='fadeInDownSmall', data-caption-delay='250s')
                  | Professional Investment Management
                h2.slider-header(data-caption-animate='fadeIn', data-caption-delay='0s')
                  | Join 30.000+ Clients that
                  br
                  | Entrust Their Money to Us
                a.btn.btn-icon.btn-icon-right.btn-primary.btn-nuka.big(data-caption-animate='fadeInUpSmall', data-caption-delay='250', href='#')
                  span.icon.icon-xs.fa-angle-right
                  | Get a Quote


      .swiper-slide.bg-overlay-dark(data-slide-bg='images/home-slider-1-slide-2.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-md-center.justify-content-xl-start
              .col-xl-1.d-none.d-xl-inline-block.d-xxl-none
              .col-md-11.col-lg-10.col-xl-8.text-xl-start
                h2.slider-header(data-caption-animate='fadeInRight', data-caption-delay='0s')
                  | Do Your Financial
                  br
                  | Strategies Need Speed?

                p.text-bigger.fw-normal.slider-text(data-caption-animate='fadeInRight', data-caption-delay='150') We can offer you services that build a better financial future.
                a.btn.btn-icon.btn-icon-right.btn-primary.btn-nuka.big(data-caption-animate='fadeInRight', data-caption-delay='300', href='#')
                  span.icon.icon-xs.fa-angle-right
                  | Get a Quote


    //-Swiper Navigation
    .swiper-scrollbar.d-xl-none
    .swiper-nav-wrap
      .swiper-button-prev
      .swiper-button-next

='\n'

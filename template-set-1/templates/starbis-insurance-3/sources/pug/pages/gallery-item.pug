extends  ../_skeleton

//- Includes
include ../elements/_ui-post-minimal

block variables
  - var activeIndex = 3
  - var pageName = 'Gallery item'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  +page-title('Gallery', 'bg-image-1')

  //- Starting a Web Design Project
  section.section-60.section-md-75.section-xl-90
    .container
      h3.text-spacing--25 Insurance and Financial Stability
      article.post-info
        .post-image
          +jpg('gallery-item-1-1170x883')
        .post-main
          .post-left
            ul.post-meta
              li: time(datetime='2021-05-01') May 2021
              li by John Doe
              li
                ul.list-hashtags
                  li: a(href='#') insurance,
                  li: a(href='#') financial,
                  li: a(href='#') stability,
                  li: a(href='#') money

          .post-body
            p Devirginatos congregabo in piscinam! Hercle, impositio grandis!, fortis species! Sunt deuses imperium azureus, clemens heureteses. Heu, velox cacula! Cur ventus ire? Cur torquis ortum? Castors unda, tanquam audax medicina. Est placidus urbs, cesaris. Sunt specieses locus alter, noster detriuses. Sunt nuclear vexatum iacerees transferre festus, rusticus lumenes. Placidus castors ducunt ad ausus. Humani generiss cantare in chremisa! Quadra, extum, et historia. Ecce, audax extum! Domuss tolerare, tanquam fortis lanista. Cur silva cadunt? Pol, bi-color cursus! Vox, gabalium, et sectam. Cum ausus nocere, omnes plasmatores imperium castus, grandis repressores. Sunt omniaes magicae superbus, germanus monses. Cum orgia assimilant, omnes sagaes resuscitabo noster, nobilis mineralises.

  ='\n'

  //- Related posts
  section.section-35.section-md-75.section-xl-90.bg-whisper
    .container.text-center.text-sm-start
      .row
        .col-sm-12
          h4 Related posts

      .row.row-30
        .col-md-10.col-lg-6
          +post-minimal({
            img: 'gallery-item-2-220x224',
            header: 'Just Married! Now What?',
            time: ['2021-03-14', 'March 14'],
            text: 'People grow up, age, get married.  Weddings are a monumental life event.  But before a couple can spend their life...'
          })

        .col-md-10.col-lg-6
          +post-minimal({
            img: 'gallery-item-3-220x224',
            header: 'Wet Weather Driving Tips',
            time: ['2021-03-13', 'March 14'],
            text: 'In this transition period from the end of winter to the start of spring, the weather is wet.  From snow to ice to rain, to melting...'
          })

        .col-md-10.col-lg-6
          +post-minimal({
            img: 'gallery-item-4-220x224',
            header: 'Flood Insurance Basics',
            time: ['2021-03-12', 'March 14'],
            text: 'Each year flooding causes an average of $43,000 per claim and over $3.5 Billion total in claims.  Homeowners insurance...'
          })

        .col-md-10.col-lg-6
          +post-minimal({
            img: 'gallery-item-5-220x224',
            header: 'Auto Insurance Basics',
            time: ['2021-03-11', 'March 14'],
            text: 'Auto insurance can be confusing and overwhelming.  To help you understand it and make it a bit simpler, we have made a...'
          })
  ='\n'


  //- Page Footer
  include ../sections/_section-footer-default

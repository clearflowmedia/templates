extends  ../_skeleton

block variables
	- var activeIndex = 4
	- var pageName = 'Forms'

block title
	title=pageName

block page
	//- Page Header
	include ../sections/_section-header-default

	//- Page Content
	+page-title(pageName, 'bg-image-2')

	//- Forms
	section.section-60.section-md-top-90.section-md-bottom-100
		.container
			.row
				//- Login Form
				.col-md-7.col-lg-5.col-xl-4.text-center.text-md-start
					h3 Login Form

					//- Block shadow
					.block-shadow.text-center
						.block-inner
							p.text-uppercase.text-abbey.fw-bold.font-accent Log in to your account
							.icon-block
								span.icon.icon-xl.icon-black.material-icons-lock_open

						//- RD Mailform
						form.rd-mailform.form-modern.form-darker.form-login
							.block-inner
								.form-group
									input#login-form-login.form-control(type="text" name="login" data-constraints="@Required")
									label.form-label(for="login-form-login") Login
								.form-group
									input#login-form-password.form-control(type="password" name="pass" data-constraints="@Required")
									label.form-label(for="login-form-password") Password
								.info-text
									a.link-default(href='#') Forgot your password?

							button(type="submit").btn.btn-primary.btn-round-bottom.btn-block Sign in

					.group-inline.text-center
						span.text-gray-base-08 Haven’t an account?
						a.link.link-primary-inverse(href='register.html') Sign up here.

			//- Feedback Form
			.row
				.col-lg-9.col-xl-7
					h3 Feedback Form
					//- RD Mailform
					form.rd-mailform.form-modern(data-form-output="form-output-global", data-form-type='contact', method='post', action='bat/rd-mailform.php')
						.row.row-40
							.col-md-5
								.form-group
									input#appointment-name.form-control(type="text" name="name" data-constraints="@Required")
									label.form-label(for="appointment-name") Name
							.col-md-7
								.form-group
									input#appointment-email.form-control(type="email" name="email" data-constraints="@Email @Required")
									label.form-label(for="appointment-email") Email
							.col-md-5
								.form-group
									input#appointment-date.form-control(type="text" name="date" data-constraints="@Required", data-time-picker='date')
									label.form-label(for="appointment-date") Date
							.col-md-7
								.form-group
									input#appointment-time.form-control(type="text" name="time" data-constraints="@Required", data-time-picker='time')
									label.form-label(for="appointment-time") Time Interval
							.col-sm-12
								.form-group
									.textarea-lined-wrap
										textarea#appointment-message.form-control(name="message" data-constraints="@Required")
										label.form-label(for="appointment-message") Message

							.col-sm-8
								button(type="submit").btn.btn-primary.btn-block Send

							.col-sm-4
								button(type="reset").btn.btn-silver-outline.btn-block Reset
	='\n'

	//- Feedback Form 2
	section.section-35.section-md-75.section-xl-100.bg-athens-gray
		.container
			.row
				.col-lg-9.col-xl-6
					h3 Feedback Form 2
					//- RD Mailform
					form.rd-mailform(data-form-output="form-output-global", data-form-type='contact', method='post', action='bat/rd-mailform.php')
						.row.row-30
							.col-md-6
								.form-group
									input#feedback-2-first-name.form-control(type="text" name="first-name" data-constraints="@Required")
									label.form-label(for="feedback-2-first-name") First Name
							.col-md-6
								.form-group
									input#feedback-2-last-name.form-control(type="text" name="last-name" data-constraints="@Required")
									label.form-label(for="feedback-2-last-name") Last Name
							.col-md-6
								.form-group
									input#feedback-2-email.form-control(type="email" name="email" data-constraints="@Email @Required")
									label.form-label(for="feedback-2-email") Email
							.col-md-6
								.form-group
									input#feedback-2-phone.form-control(type="text" name="phone" data-constraints="@Numeric @Required")
									label.form-label(for="feedback-2-phone") Phone
							.col-sm-12
								.form-group
									textarea#feedback-2-message.form-control(name="message" data-constraints="@Required")
									label.form-label(for="feedback-2-message") Message

							.col-md-6
								button(type="submit").btn.btn-primary-outline.btn-block Send
	='\n'

	//- Newsletter
	section.section-40.section-md-90
		.container
			.row
				.col-md-6.col-lg-5.col-xl-4
					h3 Newsletter
					//- RD Mailform
					form.rd-mailform.form-modern(data-form-output="form-output-global", data-form-type='subscribe', method='post', action='bat/rd-mailform.php')
						.form-group
							input#newsletter-email.form-control(type="email" name="email" data-constraints="@Email @Required")
							label.form-label(for="newsletter-email") Email
						button(type="submit").btn.btn-primary.btn-block Subscribe
	='\n'

	//- Mailchimp
	section.section.section-40.section-md-75.bg-whisper
		.container
			.row
				.col-md-6.col-lg-5.col-xl-4
					h3 MailChimp
					// Mailchimp
					form.rd-form.mailchimp-mailform.form-modern(data-form-output='form-output-global' action='https://templatemonster.us1.list-manage.com/subscribe/post?u=1e39a6d114a4cc130a4edbe43&id=9fc9ef194a' method='post')
						.form-wrap.form-wrap_icon.linear-icon-envelope
							label.form-label(for='mailchimp-email') Enter your e-mail
							input#mailchimp-email.form-control(type='email' name='email' data-constraints='@Email @Required')

						button.btn.btn-primary.btn-block(type='submit') Subscribe
	='\n'

	//- Campaign monitor
	section.section.section-40.section-md-75
		.container
			.row
				.col-md-6.col-lg-5.col-xl-4
					h3 Campaign Monitor
					//- RD Mailform
					form.rd-form.campaign-mailform.form-modern(data-form-output='form-output-global' action='https://templatermonster.createsend.com/t/j/s/zjjikd/' method='post')
						.form-wrap.form-wrap_icon.linear-icon-envelope
							label.form-label(for='campaign-email') Enter your e-mail
							input#campaign-email.form-control(type='email' name='cm-zjjikd-zjjikd' data-constraints='@Email @Required')

						button.btn.btn-primary.btn-block(type='submit') Subscribe
	='\n'

	//- Page Footer
	include ../sections/_section-footer-default

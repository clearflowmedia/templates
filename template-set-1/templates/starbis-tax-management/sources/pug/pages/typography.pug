extends  ../_skeleton

//- Includes
include ../elements/_ui-quote-default
include ../elements/_ui-placeholders

block variables
  - var activeIndex = 4
  - var pageName = 'Typography'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title(pageName, 'bg-image-1')

  //- Typography
  section.section-60.section-md-top-75.section-md-bottom-50
    .container
      .row.row-40
        .col-md-6
          h1 Heading 1
          +text-placeholder

        .col-md-6
          h2 Heading 2
          +text-placeholder

      .row.row-30
        .col-md-6
          h3 Heading 3
          +text-placeholder

        .col-md-6
          h4 Heading 4
          +text-placeholder

      .row.row-30
        .col-md-6
          h5 Heading 5
          +text-placeholder

        .col-md-6
          h6.text-uppercase Heading 6
          +text-placeholder
  ='\n'

  //- Blockquote
  section.section-45
    .container
      .row
        .col-sm-12
          h3 Blockquote
          div(style='max-width: 530px;')
            +quote-default('We must have a fair tax. We have to re-adjust it, we must be fiscally responsible!')
  ='\n'

  //- Text Formatting
  section.section-md-50
    .container
      .row
        .col-sm-12
          h3 Text Formatting
          .box-text
            a(href='#').link.link-primary-inline Link text
            a(href='#').link.link-primary-inline Hover link text
            a(href='#').link.link-primary-inline.active Press link
            span.mark highlighted text
            span.text-strike.text-tundora strickethrough text
            span.text-underline.text-tundora underlined text.
  ='\n'


  //- Image Centered
  section.section-45
    .container
      .row
        .col-sm-12
          h3 Image Centered
          figure
            +jpg('typography-1-1169x610')
          p.text-gray-base Tax advisers can work in compliance, ensuring a client meets all tax obligations by preparing and submitting tax returns, tax computations and any other necessary forms.
  ='\n'

  //- Image Right
  section.section-35.section-md-50
    .container
      .row
        .col-sm-12
          h3 Image Right
      .row.flex-md-row-reverse.justify-content-md-between.row-30
        .col-md-6
          figure
            +jpg('typography-2-570x386')
        .col-md-6
          .inset-lg-right-40.inset-xl-right-85.text-gray-base
            p.
              Tax is a dynamic and fast paced industry which requires not only analytical ability, but excellent problem solving and commercial skills. For everything that has economic consequences, whether it is for a company, an individual or the Government - tax is relevant, as is the need for tax advisers.
            p.
              A career in tax has an enormous amount to offer, including variety, intellectual stimulation and an ever-changing, dynamic working environment. The complex and diverse nature of taxation means that tax advisers rapidly develop areas of specialist knowledge. Using a tax advisor to manage your taxation affairs can be very rewarding. Professionals are much more likely to be aware of more of the ways in which your taxes can be optimised so that you pay the least possible amount.
  ='\n'

  //- Image Left
  section.section-40.section-md-bottom-100.section-xl-bottom-165
    .container
      .row
        .col-sm-12
          h3 Image Left
      .row.justify-content-md-between.row-30
        .col-md-6
          figure
            +jpg('typography-3-570x386')
        .col-md-6
          .inset-lg-left-40.inset-xl-left-85.text-gray-base
            p.
              Tax is a dynamic and fast paced industry which requires not only analytical ability, but excellent problem solving and commercial skills. For everything that has economic consequences, whether it is for a company, an individual or the Government - tax is relevant, as is the need for tax advisers.
            p.
              A career in tax has an enormous amount to offer, including variety, intellectual stimulation and an ever-changing, dynamic working environment. The complex and diverse nature of taxation means that tax advisers rapidly develop areas of specialist knowledge. Using a tax advisor to manage your taxation affairs can be very rewarding. Professionals are much more likely to be aware of more of the ways in which your taxes can be optimised so that you pay the least possible amount.
  ='\n'


  //- Page Footer
  include ../sections/_section-footer-default
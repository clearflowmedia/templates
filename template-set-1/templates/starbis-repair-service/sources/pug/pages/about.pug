	section.section.section-lg.bg-gray-lighter
		.container
			.row.row-40.row-lg-60
				.col-sm-6.col-md-4.col-lg-3
					+thumbnail-1({
						img: 'team-1-189x189.png',
						header: "Ralph Edwards",

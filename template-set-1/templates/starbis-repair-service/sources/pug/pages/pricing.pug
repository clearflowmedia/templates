extends  ../_skeleton
include ../elements/_pricing

block variables
	- pageName = 'Pricing'

block page
	//- Page Header
	include ../sections/_section-header-default

	//- Page Content
	+page-title(pageName, 'bg-image-2')

	//- Choose your package
	section.section.section-md.bg-sky-blue
		.container
			.row.row-30
				.col-md-6.col-lg-4
					+pricing({
						title: 'Basic',
						subtitle: 'Perfect for Simple Repair',
						price: '65',
						options: ['Repairs', 'Maintenance'],
						info: 'Other services can be ordered <br> at an extra rate.'
					})
				.col-md-6.col-lg-4
					+pricing({
						title: 'Standard',
						subtitle: 'Most popular',
						price: '120',
						options: ['Repairs', 'Maintenance', 'Refinishing'],
						info: 'Cleaning work are available <br> for additional $20.'
					})
				.col-md-6.col-lg-4
					+pricing({
						title: 'Ultimate',
						subtitle: 'All services are included',
						price: '250',
						options: ['Repairs', 'Maintenance', 'Refinishing', 'Custom design work', 'Cleaning']
					})
	//- Questions & Answers
	section.section.section-md.bg-default
		.container
			h3.text-center Questions & Answers
			.row.row-40.row-lg
				.col-md-6
					dl.list-terms-variant-1
						dt How does the 14-day trial work?

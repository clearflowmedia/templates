extends  ../_skeleton

//- Includes
include ../elements/_icon-box
include ../elements/_icon-box-vertical
include ../elements/_icon-box-horizontal

block variables
	- pageName = 'Icon lists'

block page
	//- Page Header
	include ../sections/_section-header-default

	//- Page Content
	+page-title(pageName, 'bg-image-1')

	//- Lists
	section.section.section-md.bg-default
		.container
			h3 Lists
			.row.row-40
				.col-sm-6.col-md-4.col-xl-3
					h5 Unordered List
					ul.list-marked
						li Responsive & Retina-ready
						li Extensive docs
						li Powerful Navigation
						li Video Backgrounds
						li Social Plugins

				.col-sm-6.col-md-4.col-xl-3
					h5 Ordered List
					ul.list-ordered
						li Responsive & Retina-ready
						li Extensive docs
						li Powerful Navigation
						li Video Backgrounds
						li Social Plugins

	//- Icon Left List
	section.section.section-md.bg-default
		.container
			h3 Icon Left List
			.row
				.col-lg-9.col-xl-12
					.row.row-40
						.col-md-6.col-xl-3
							+icon-box-left({
								icon: ['icon-lg-variant-1', 'material-icons-device_hub'],

extends  ../_skeleton

//- Includes
include ../elements/_thumbnail-3
include ../elements/_quote-default
include ../elements/_progress-linear

block variables
	- pageName = 'Team member profile'

block page
	//- Page Header
	include ../sections/_section-header-default

	//- Page Content
	+page-title('Our team', 'bg-image-6')

	//- Julien Miro
	section.section.section-lg.bg-default
		.container
			.row.row-40.justify-content-md-center.justify-content-lg-start
				.col-md-6
					.thumbnail.thumbnail-profile
						.thumbnail-image
							+img('profile-1-570x570')
						.thumbnail-caption
							.thumbnail-caption-inner
								ul
									li
										.unit.unit-spacing-xs.align-items-center
											.unit-left: span.icon.icon-xxs.icon-black.material-icons-phone
											.unit-body
												a.link-black-v2(href='tel:#') +1 (232) 349–8447
									li
										.unit.unit-spacing-xs.align-items-center
											.unit-left: span.icon.icon-xxs.icon-black.fa-envelope-o
											.unit-body
												a.link-black-v2(href='mailto:#') info@demolink.org
								.btn-wrap
									a.btn.btn-circle.btn-small.btn-black-outline(href='contact-us.html') get in touch

				.col-md-6.col-lg-6.col-xl-5
					.inset-md-left-50.inset-lg-left-40.inset-xl-left-100
						h4 Ralph Edwards
						p.offset-top-0 Floor and coverings expert
						p Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aliquid architecto aspernatur dolore, eum exercitationem harum, iste iusto modi nemo numquam pariatur praesentium reiciendis sint, voluptas.

					+quote-default('I can make your renovation dream come true without any complexities and extra charges!')

					.inset-md-left-50.inset-lg-left-40.inset-xl-left-100
						p Blanditiis cum fugiat maxime odio quis unde. Aut eligendi laborum mollitia nam neque reiciendis vitae. Earum et iure neque placeat quasi voluptatem? Expedita itaque neque perspiciatis quod?
						.pt-3
							+progress-linear({
								title: 'Knowledge',
								value: '75'
							})
							+progress-linear({
								title: 'Dedication',
								value: '85'
							})

							+progress-linear({
								title: 'Professionalism',
								value: '80'
							})



	//- Portfolio
	section.section.section-lg.bg-mine-shaft
		.container.isotope-wrap.isotope-style-inverse
			.row.row-40
				.col-sm-12.text-center
					h3
						span Check out
						em Ralph’s projects
					p.d-inline-block(style='max-width: 820px;') In his portfolio there are hundreds of successful projects and dozens of satisfied customers. Check out the gallery to learn more about his skills and style.

					//- Isotope Filters
					ul.isotope-filters-responsive
						li: p Choose your category:
						li.block-top-level
							//- Isotope Filters
							button.isotope-filters-toggle.btn.btn-sm.btn-default(data-custom-toggle='#isotope-1', data-custom-toggle-hide-on-blur='true', data-custom-toggle-disable-on-blur='true')
								| Filter
								span.caret

							#isotope-1.isotope-filters.isotope-filters-light.isotope-filters-minimal.isotope-filters-horizontal
								ul.list-inline
									li: a.active(data-isotope-filter='*', href='#') All
									li: a(data-isotope-filter='Category 1', href='#') Interior
									li: a(data-isotope-filter='Category 2', href='#') Exterior
									li: a(data-isotope-filter='Category 3', href='#') Other

				.col-sm-12
					.row.isotope.isotope-gutter-default( data-lightgallery='group', data-lg-thumbnail='false')
						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
							+thumbnail-3({img: 'gallery-grid-1-370x278', original: 'grid-gallery-01-original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
							+thumbnail-3({img: 'gallery-grid-2-370x278', original: 'grid-gallery-02-original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
							+thumbnail-3({img: 'gallery-grid-3-370x278', original: 'grid-gallery-03-original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
							+thumbnail-3({img: 'gallery-grid-4-370x278', original: 'grid-gallery-04-original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
							+thumbnail-3({img: 'gallery-grid-5-370x278', original: 'grid-gallery-05-original'})

						.col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
							+thumbnail-3({img: 'gallery-grid-6-370x278', original: 'grid-gallery-06-original'})


	//- Page Footer
	include ../sections/_section-footer-default

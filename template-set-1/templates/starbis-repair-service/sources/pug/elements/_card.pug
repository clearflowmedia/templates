//- Bootstrap Card
	@param {object}  obj           - card object
	@param {boolean} obj.show      - is card not collapsed
	@param {string}  obj.parentId  - parent accordion id
	@param {string}  obj.title     - card title
mixin card( obj )
	-
		var
				headId = obj.parentId + '-card-head-' + randomStr(8),
				bodyId = obj.parentId + '-card-body-' + randomStr(8);

	.accordion-item
		h2.accordion-header( id= headId )
			button.accordion-button(class= obj.show ? '' : 'collapsed', type='button', data-bs-toggle='collapse', data-bs-target='#' + bodyId, aria-expanded= obj.show || 'false', aria-controls= bodyId)= obj.title
		.accordion-collapse.collapse(class= obj.show ? 'show' : '', id= bodyId, aria-labelledby= headId, data-bs-parent= '#' + obj.parent)
			.accordion-body
				p= obj.text

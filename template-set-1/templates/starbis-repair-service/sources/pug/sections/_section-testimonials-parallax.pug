//- Include
include ../elements/_quote-minimal

//- Parallax
+parallax({
	img: 'clients-testimonials-parallax-1'
}).bg-black
	.section-lg
		.container.text-center
			h3 What People Say
			.row.justify-content-lg-center
				.col-lg-11.col-xl-9
					//- Owl Carousel
					.owl-carousel-inverse
						.owl-carousel.owl-nav-position-numbering(
						data-items='1',
						data-stage-padding='0',
						data-loop='false',
						data-margin='30',
						data-nav='true',
						data-numbering='#owl-numbering-1',
						data-animation-in='fadeIn',
						data-animation-out='fadeOut')
							.item
								+quote-minimal({
									mod: "quote-minimal-inverse",
									text: 'Vestibulum posuere tortor lacus, at hendrerit nisl consectetur et. Lorem ipsum dolor sit amet, consectetur adipisicing elit. Nunc semper euismod lacus. Etiam dapibus erat purus, a malesuada turpis rutrum vel.',
									cite: "Jane Wilson",
									caption: 'Client'
								})

							.item
								+quote-minimal({
									mod: "quote-minimal-inverse",
									text: 'Mauris a bibendum libero, id ornare enim. Lorem ipsum dolor sit amet, consectetur adipisicing elit. Integer convallis, dolor a malesuada blandit, mauris augue ultrices dolor, euismod ullamcorper erat tortor et ex.',
									cite: "Amanda Smith",
									caption: 'Client'
								})

							.item
								+quote-minimal({
									mod: "quote-minimal-inverse",
									text: 'Donec porttitor rutrum luctus. Fusce tristique semper orci et condimentum. Donec tincidunt vulputate luctus. Lorem ipsum dolor sit amet, consectetur adipisicing elit. Sed vitae leo ex. Praesent luctus semper nunc.',
									cite: "Sam Cole",
									caption: 'Client'
								})
						#owl-numbering-1.owl-numbering.owl-numbering-default
							.numbering-current
							.numbering-separator
							.numbering-count


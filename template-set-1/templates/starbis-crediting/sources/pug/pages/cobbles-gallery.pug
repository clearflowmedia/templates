extends  ../_skeleton

//- Includes
include ../elements/_ui-thumbnail-3

block variables
  - var activeIndex = 2
  - var pageName = 'Cobbles Gallery'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title(pageName, 'bg-image-1', {
    0: {
      "title": "Home",
      "href": "./"
    },
    1: {
      "title": "Products",
      "href": "#"
    },
    2: {
      "title": 'Cobbles Gallery'
    }
  })

  //- Gallery cobbles
  section.section-66.section-lg-bottom-100.bg-default
    .container.isotope-wrap
      .row.row-40.text-center
        .col-12
          //- Isotope Filters
          ul.isotope-filters-responsive
            li: p Choose your category:
            li.block-top-level
              //- Isotope Filters
              button.isotope-filters-toggle.btn.btn-sm.btn-default(data-custom-toggle='#isotope-1', data-custom-toggle-hide-on-blur='true')
                | Filter
                span.caret

              #isotope-1.isotope-filters.isotope-filters-minimal.isotope-filters-horizontal
                ul.list-inline
                  li
                    a.active(data-isotope-filter='*', data-isotope-group='gallery', href='#') All
                  li
                    a(data-isotope-filter='Category 1', data-isotope-group='gallery', href='#') Discount mortgages
                  li
                    a(data-isotope-filter='Category 2', data-isotope-group='gallery', href='#') Tracker mortgages
                  li
                    a(data-isotope-filter='Category 3', data-isotope-group='gallery', href='#') Offset mortgages

        //- Isotope Content
        .col-12
          .isotope.isotope-condensed(data-isotope-layout='masonry', data-isotope-group='gallery', data-lightgallery='group', data-column-width='.42')
            .isotope-item.isotope-item-width-33p(data-filter='Category 1')
              +thumbnail-3({img: 'gallery-cobbles-1-390x601', original: 'original-667x1000_01'})

            .isotope-item.isotope-item-width-33p(data-filter='Category 2')
              +thumbnail-3({img: 'gallery-cobbles-2-390x301', original: 'original-1000x667_02'})

            .isotope-item.isotope-item-width-33p(data-filter='Category 1')
              +thumbnail-3({img: 'gallery-cobbles-3-390x301', original: 'original-1000x667_03'})

            .isotope-item.isotope-item-width-66p(data-filter='Category 2')
              +thumbnail-3({img: 'gallery-cobbles-4-780x300', original: 'original-1000x667_05'})

            .isotope-item.isotope-item-width-66p(data-filter='Category 3')
              +thumbnail-3({img: 'gallery-cobbles-5-780x600', original: 'original-1000x667_07'})

            .isotope-item.isotope-item-width-33p(data-filter='Category 3')
              +thumbnail-3({img: 'gallery-cobbles-6-390x300', original: 'original-1000x667_06'})

            .isotope-item.isotope-item-width-33p(data-filter='Category 3')
              +thumbnail-3({img: 'gallery-cobbles-7-390x300', original: 'original-1000x669_08'})
  ='\n'

  //- Page Footer
  include ../sections/_section-footer-default

extends  ../_skeleton

//- Includes
include ../elements/_ui-thumbnail-3

block variables
  - var activeIndex = 2
  - var pageName = 'Grid Gallery'

block title
  title='Grid Gallery'

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title(pageName, 'bg-image-1', {
    0: {
      "title": "Home",
      "href": "./"
    },
    1: {
      "title": "Products",
      "href": "#"
    },
    2: {
      "title": pageName
    }
  })

  //- Grid gallery
  section.section-66.section-lg-bottom-100.bg-default
    .container.isotope-wrap.text-center
      .row.row-40
        .col-12
          //- Isotope Filters
          ul.isotope-filters-responsive
            li: p Choose your category:
            li.block-top-level
              //- Isotope Filters
              button.isotope-filters-toggle.btn.btn-sm.btn-default(data-custom-toggle='#isotope-1', data-custom-toggle-hide-on-blur='true')
                | Filter
                span.caret

              #isotope-1.isotope-filters.isotope-filters-minimal.isotope-filters-horizontal
                ul.list-inline
                  li
                    a.active(data-isotope-filter='*', data-isotope-group='gallery', href='#') All
                  li
                    a(data-isotope-filter='Category 1', data-isotope-group='gallery', href='#') Discount mortgages
                  li
                    a(data-isotope-filter='Category 2', data-isotope-group='gallery', href='#') Tracker mortgages
                  li
                    a(data-isotope-filter='Category 3', data-isotope-group='gallery', href='#') Offset mortgages

        //- Isotope Content
        .col-12
          .row.isotope.isotope-gutter-default(data-isotope-layout='fitRows', data-isotope-group='gallery', data-lightgallery='group')
              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
                +thumbnail-3({img: 'gallery-grid-1-370x278', original: 'original-667x1000_01'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
                +thumbnail-3({img: 'gallery-grid-2-370x278', original: 'original-1000x667_02'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
                +thumbnail-3({img: 'gallery-grid-3-370x278', original: 'original-1000x667_03'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
                +thumbnail-3({img: 'gallery-grid-4-370x278', original: 'original-1000x548_04'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
                +thumbnail-3({img: 'gallery-grid-5-370x278', original: 'original-1000x667_05'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
                +thumbnail-3({img: 'gallery-grid-6-370x278', original: 'original-1000x667_06'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
                +thumbnail-3({img: 'gallery-grid-7-370x278', original: 'original-1000x667_07'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
                +thumbnail-3({img: 'gallery-grid-8-370x278', original: 'original-1000x669_08'})

              .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
                +thumbnail-3({img: 'gallery-grid-9-370x278', original: 'original-1000x667_09'})
  ='\n'

  //- Page Footer
  include ../sections/_section-footer-default

extends  ../_skeleton

//- Includes
include ../elements/_ui-icon-box
include ../elements/_ui-icon-box-vertical
include ../elements/_ui-icon-box-horizontal

block variables
  - var activeIndex = 3
  - var pageName = 'Icon Lists'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title(pageName, 'bg-image-1', {
    0: {
      "title": "Home",
      "href": "./"
    },
    1: {
      "title": "Additional Pages",
      "href": "#"
    },
    2: {
      "title": pageName
    }
  })

  //- Lists
  section.section-40.section-md-top-75.section-md-bottom-50.section-xl-top-90.text-start
    .container
      .row.row-60.row-lg-90
        .col-xl-8
          h3 Unordered List
          p We specialize in a variety of services. Our aim is to deliver the top level of customer service based on your requests.
          ul.list-marked
            li Consulting
            li Customer Service
            li Innovation
            li Management
            li Ethics
          p We hope that with our services you will receive the most personalized help in purchasing any kind of products you are looking for.

        .col-xl-8
          h3 Ordered List
          p We specialize in a variety of services. Our aim is to deliver the top level of customer service based on your requests.
          ul.list-ordered
            li Consulting
            li Customer Service
            li Innovation
            li Management
            li Ethics
          p We hope that with our services you will receive the most personalized help in purchasing any kind of products you are looking for.

extends  ../_skeleton

//- Includes
include ../elements/_ui-thumbnail-3

block variables
  - var activeIndex = 2
  - var pageName = 'Masonry Gallery'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title(pageName, 'bg-image-1', {
    0: {
      "title": "Home",
      "href": "./"
    },
    1: {
      "title": "Products",
      "href": "#"
    },
    2: {
      "title": pageName
    }
  })

  //- Gallery Masonry
  section.section-66.section-lg-bottom-100.bg-default
    .container.isotope-wrap
      .row.row-40.text-center
        .col-12
          //- Isotope Filters
          ul.isotope-filters-responsive
            li: p Choose your category:
            li.block-top-level
              //- Isotope Filters
              button.isotope-filters-toggle.btn.btn-sm.btn-default(data-custom-toggle='#isotope-1', data-custom-toggle-hide-on-blur='true')
                | Filter
                span.caret

              #isotope-1.isotope-filters.isotope-filters-minimal.isotope-filters-horizontal
                ul.list-inline
                  li
                    a.active(data-isotope-filter='*', data-isotope-group='gallery', href='#') All
                  li
                    a(data-isotope-filter='Category 1', data-isotope-group='gallery', href='#') Discount mortgages
                  li
                    a(data-isotope-filter='Category 2', data-isotope-group='gallery', href='#') Tracker mortgages
                  li
                    a(data-isotope-filter='Category 3', data-isotope-group='gallery', href='#') Offset mortgages

        //- Isotope Content
        .col-12
          .row.isotope.isotope-gutter-default(data-isotope-layout='masonry', data-isotope-group='gallery', data-lightgallery='group', data-column-width='.418')
            .col-12.col-md-6.col-lg-8.isotope-item(data-filter='Category 1')
              +thumbnail-3({img: 'gallery-masonry-1-770x586', original: 'original-1000x667_03'})

            .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
              +thumbnail-3({img: 'gallery-masonry-2-370x278', original: 'original-1000x667_02'})

            .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 3')
              +thumbnail-3({img: 'gallery-masonry-3-371x587', original: 'original-667x1000_01'})

            .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
              +thumbnail-3({img: 'gallery-masonry-4-373x279', original: 'original-1000x667_07'})

            .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 2')
              +thumbnail-3({img: 'gallery-masonry-5-373x279', original: 'original-1000x667_05'})

            .col-12.col-md-6.col-lg-8.isotope-item(data-filter='Category 3')
              +thumbnail-3({img: 'gallery-masonry-6-769x384', original: 'original-1000x669_08'})

            .col-12.col-md-6.col-lg-4.isotope-item(data-filter='Category 1')
              +thumbnail-3({img: 'gallery-masonry-7-371x384', original: 'original-1000x667_09'})
  ='\n'

  //- Page Footer
  include ../sections/_section-footer-default

    .container.container-top-0.section-60.section-lg-top-80.section-lg-bottom-100
      h2.text-spacing-50 About Us
      a.video-cover(style='background: url(images/home-1-1169x524.jpg) center top; background-size: cover;' data-lightbox='iframe', href='https://www.youtube.com/watch?v=1UWpbtUupQQ')
        span.link-circle.link-white: span.icon.icon-xl.mdi.mdi-play
  ='\n'

  section.section-60.section-lg-100.section-transform.bg-transform.context-dark
    .container.text-lg-start
      .row.row-30.justify-content-lg-between
        .col-lg-5
          h2 Better Rates
          h5.offset-top-15 By using better data
          p.text-spacing-50.inset-xl-right-50 There's more to you than your credit score. Your education and job history help us understand more about your future.
          //Select 2
          form(action='#').rd-mailform-inline
            .select-2-white.form-wrap
              select.form-input.select-filter(data-placeholder="I would like to", data-minimum-results-for-search="Infinity", data-constraints="@Required")
                option(value="2") Demo Item 1-1
                option(value="3") Demo Item 1-2
                option(value="4") Demo Item 1-2
                option(value="5") Demo Item 2-1
                option(value="6") Demo Item 2-2
                option(value="7") Demo Item 2-3
            button.btn.btn-link.btn-link-white(style='min-width: 174px;') Check Your Rate
        .col-lg-6.col-lg-divider
          table.table-transparent
            tr
              th
              th
                img(src="images/logo-white.png", width="104", height="37", alt="logo")
              th
                .h6 Other Lenders
            tr
              td FICO score
              td: span.icon.icon-primary.mdi.mdi-check.icon-md-smaller
              td: span.icon.icon-dust.mdi.mdi-check.icon-md-smaller
            tr
              td Years of credit
              td: span.icon.icon-primary.mdi.mdi-check.icon-md-smaller
              td: span.icon.icon-dust.mdi.mdi-check.icon-md-smaller
            tr
              td Education
              td: span.icon.icon-primary.mdi.mdi-check.icon-md-smaller
              td: span.icon.icon-dust.mdi.mdi-check.icon-md-smaller
            tr
              td Area of study
              td: span.icon.icon-primary.mdi.mdi-check.icon-md-smaller
              td
            tr
              td Job history
              td: span.icon.icon-primary.mdi.mdi-check.icon-md-smaller
              td
    .bg-transform-inner.bg-colin
  //- Team
  section.section-75.section-lg-100.text-start.bg-default
    .container
      include ../sections/_section-testimonials


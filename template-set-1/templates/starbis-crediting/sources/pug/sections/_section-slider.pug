//- Swiper
section.swiper-container.swiper-slider.swiper-variant-1.bg-black(data-loop='true', data-autoplay='5500', data-simulate-touch='true')
	.swiper-wrapper.text-center
		.swiper-slide(data-slide-bg='images/home-slider-1-slide-1.jpg')
			.swiper-slide-caption
				.container
					.row.justify-content-md-center
						.col-md-11.col-lg-10.col-xl-9
							h2.slider-header(data-caption-animate='fadeInUp', data-caption-delay='0s') More Than
								br.d-none.d-lg-block
								=' You Expect'
							p.slider-text(data-caption-animate='fadeInUp', data-caption-delay='300') Loan for any purpose under 0.03% per day
							a.btn.btn-link.btn-link-primary(href='pricing.html' data-caption-animate='fadeInUp', data-caption-delay='600') Check Your Rate

		.swiper-slide(data-slide-bg='images/home-slider-1-slide-2.jpg')
			.swiper-slide-caption
				.container
					.row.justify-content-md-center
						.col-md-11.col-lg-10.col-xl-9
							h2.slider-header(data-caption-animate='fadeInUp', data-caption-delay='0s') Smart
								br.d-none.d-lg-block
								=' Personal Loans'
							p.slider-text(data-caption-animate='fadeInUp', data-caption-delay='300') Get a competitive personal loan quickly with FastCredit
							a.btn.btn-link.btn-link-primary(href='pricing.html' data-caption-animate='fadeInUp', data-caption-delay='600') Check Your Rate

		.swiper-slide(data-slide-bg='images/home-slider-1-slide-3.jpg')
			.swiper-slide-caption
				.container
					.row.justify-content-md-center
						.col-md-11.col-lg-10.col-xl-9
							h2.slider-header(data-caption-animate='fadeInUp', data-caption-delay='0s') A Better
								br.d-none.d-lg-block
								=' Future'
							p.slider-text(data-caption-animate='fadeInUp', data-caption-delay='300') Create a better life for you and your family
							a.btn.btn-link.btn-link-primary(href='pricing.html' data-caption-animate='fadeInUp', data-caption-delay='600') Check Your Rate

	//- Swiper Scrollbar
	.swiper-scrollbar

	//- Swiper Navigation
	.swiper-nav-wrap
		.swiper-button-prev
		.swiper-button-next

='\n'

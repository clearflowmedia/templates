extends  ../_skeleton

//- Includes
include ../elements/_ui-thumbnail-1
include ../elements/_ui-thumbnail-2

block variables
  - var activeIndex = 4
  - var pageName = 'Our Team'

block title
  title=pageName

block page
  //- Page Header
  include ../sections/_section-header-default

  //- Page Content
  +page-title(pageName, 'bg-image-1')

  //- Team
  section.section-66.section-md-100
    .container
      .row
        .col-sm-12.text-center
          h3
            | Our
            =' '
            span.fw-thin Team
      .row.justify-content-sm-center
        .col-md-8.col-xl-12
          //- Owl Carousel
          .owl-carousel.owl-carousel-center.owl-nav-modern.owl-style-minimal.owl-style-minimal-inverse.text-center(data-data-items='1', data-md-items='2', data-xl-items='3', data-stage-padding='15', data-loop='false', data-margin='15', data-mouse-drag="false", data-dots="true" )
            .item.text-center
              .thumbnail-variant-5
                .thumbnail-variant-5-img-wrap
                  img.img-circle(src="images/team-1-151x151.jpg" width="129" height="129" alt="")
                h4 John Doe
                .text-dusty-gray Managing Director
                .divider-fullwidth.bg-porcelain

                .link-group

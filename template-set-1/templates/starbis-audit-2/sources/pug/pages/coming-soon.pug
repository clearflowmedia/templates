extends  ../_skeleton

include ../_includes/_countdown
block variables
	- var pageName = 'Coming Soon'
	- var bodyClass = ['one-screen-page', 'bg-gray-darker', 'bg-image'];
	- var bodyImage = 'bg-image-4'

block title
	title=pageName

block page
	.page-inner
		//- Page Header
		include ../sections/_section-header-base-transparent

		//- Page Content
		section.text-center
			.container
				.row.justify-content-md-center.row-40.row-md-60.row-xl-90
					.col-md-12
						h3.fw-bold
							| We're Getting Ready
							br
							| to Launch in
						.row.row-60
							.col-sm-12
								.countdown-box.block-centered
									+countdown({to: '2024-01-22'})
							.col-12
								p.text-white
									| Our website is under construction, we are working very
									br.d-none.d-sm-block
									| hard to give you the best experience on our new web site.

					.col-md-6.col-lg-5.col-xl-4
						h6.text-big-19.fw-bold Stay ready, we`re launching soon
						//- RD Mailform
						form.rd-mailform.form-modern.form-inverse(data-form-output="form-output-global", data-form-type='subscribe', method='post', action='bat/rd-mailform.php')
							.form-wrap
								label.form-label.text-white-05(for="contact-email") Email
								input#contact-email.form-input.text-white-05(type="email" name="email" data-constraints="@Email @Required" style="border-color: rgba(255,255,255,0.5);")
							button(type="submit").btn.btn-primary.btn-block Subscribe
		='\n'

		//- Page Footer
		include ../sections/_section-footer-base-transparent
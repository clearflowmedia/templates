extends  ../_skeleton

//- Includes
include ../elements/_icon-box-vertical
include ../elements/_link-image

block variables
	- pageName = 'Services'

block page
	//- Page Header
	include ../sections/_section-header-default

	//- Page Content
	+page-title(pageName, 'bg-image-8')

	//- What We Do
	section.bg-black
		.divider-spectrum
		.section-66.section-md-90
			.container
				h3.text-center What We Do
				p.block-centered.text-center(style='max-width: 540px;') We will take care of your web design project regardless of its level of complexity. We are not afraid of difficult tasks – hundreds of our satisfied clients can prove that.

				.row.row-50.row-xl-60
					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-phonelink'],
							header: 'Fully Responsive Design',
							text: 'Starbis looks perfect on any modern device, be it a laptop, a smartphone, or a tablet.'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-thumb_up'],
							header: 'Social Integration',
							text: 'Starbis is integrated with such popular social networks as Facebook, Twitter, Instagram and Flickr.'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-collections'],
							header: '150+ Predesigned Pages',
							text: 'Starbis is a paradise for developers. Its initial release version comes shipped with 150+ responsive pages for any taste.'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-loop'],
							header: 'Regular Content Updates',
							text: 'New child themes, skins and predesigned pages are being released 2-3 times per month. '
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-layers'],
							header: 'Lots of Child Themes',
							text: 'A variety of niche-specific designs, which expand the possibilities of this template.'
						})

					.col-sm-6.col-lg-4
						+icon-box-vertical({
							mod: 'icon-box-vertical-sm',
							icon: ['icon-md', 'material-icons-note_add'],
							header: '200+ PSD Files',
							text: 'An impressive UI kit comprising 200+ layered PSD source files will be a useful addition to every designer’s toolbox.'
						})
		.divider-spectrum


	include ../sections/_section-why-choose-us

	//- Our Clients
	section.section.section-60.section-md-90.section-xl-bottom-120.bg-mine-shaft.novi-background
		.container
			h3 Our Clients
			.row.row-40.offset-top-2
				.col-md-7.col-lg-5.col-xl-4
					//- Owl Carousel
					.owl-carousel-wrap
						.owl-carousel.owl-nav-bottom-left(data-autoplay='true', data-items='1', data-stage-padding='0', data-loop='true', data-margin='30', data-mouse-drag="false", data-nav='true')
							.item
								p An efficient and reliable resource. They always remain flexible, cost effective, and lightning fast. Keep up the good work!
							.item
								p Got really enjoyable experience with your product. Easy set up is a huge plus. I even didn’t turn to support service.
							.item
								p I’m extremely satisfied with their work. My new website looks great and runs smoothly. The support is excellent too.

				.col-lg-7.col-xl-8
					.row.row-30.shift-md-top-1
						.col-sm-6.col-md-3
							+link-image({img: 'services-2-132x83.png'})

						.col-sm-6.col-md-3
							+link-image({img: 'services-3-169x68.png'})

						.col-sm-6.col-md-3
							+link-image({img: 'services-4-141x88.png'})

						.col-sm-6.col-md-3
							+link-image({img: 'services-5-138x55.png'})


	//- Pricing tables
	section.section.bg-decoration-wrap.bg-decoration-bottom.bg-decoration-bottom-mod.section-60.section-md-100.bg-whisper
		.container.bg-decoration-content
			.row.row-40.justify-content-md-center
				.col-lg-10.col-xl-12
					h3 Choose Your Plan
				.col-lg-10.col-xl-12
					include ../includes/_pricing-tables-range
		.bg-decoration-object.bg-iron


	include ../sections/_section-default-cta


	//- Page Footer
	include ../sections/_section-footer-default

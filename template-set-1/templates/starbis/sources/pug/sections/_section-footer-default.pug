//- Default pre-footer
section.section.section-40.section-md-top-75.section-md-bottom-60.bg-cod-gray.novi-background
	.container.text-center.text-md-start
		.row.row-30.align-items-md-center.justify-content-lg-center.justify-content-xl-start
			.col-lg-11.col-xl-3
				a.brand(href='index.html')
					+logo(true)
			.col-md-7.col-lg-6.col-xl-5
				.wrap-justify
					address.contact-info.text-start
						.unit.unit-horizontal.unit-spacing-xs.align-items-center.justify-content-center.unit-sm-left
							.unit-left: span.novi-icon.icon.icon-md-custom.icon-gunsmoke.material-icons-place
							.unit-body.fw-light
								a.link-light-03.d-inline(href='#')
									| 9784 Bear Hill Drive
									br
									| Brooklyn, NY 11228
					address.contact-info.text-start
						.unit.unit-horizontal.unit-spacing-xs.align-items-center.justify-content-center.unit-sm-left
							.unit-left: span.novi-icon.icon.icon-md-custom.icon-gunsmoke.material-icons-phone
							.unit-body.fw-light
								.link-wrap: a.link-light-03(href='tel:#') +1 800 123 45 67
								.link-wrap: a.link-light-03(href='mailto:#') info@demolink.org

			.col-md-5.col-xl-4.text-lg-center
				ul.list-inline.list-inline-xs
					li: a.novi-icon.icon.icon-sm-custom.link-tundora.fa-facebook(href='#')
					li: a.novi-icon.icon.icon-sm-custom.link-tundora.fa-twitter(href='#')
					li: a.novi-icon.icon.icon-sm-custom.link-tundora.fa-google-plus(href='#')
					li: a.novi-icon.icon.icon-sm-custom.link-tundora.fa-linkedin(href='#')
					li: a.novi-icon.icon.icon-sm-custom.link-tundora.fa-skype(href='#')
					li: a.novi-icon.icon.icon-sm-custom.link-tundora.fa-vine(href='#')
					li: a.novi-icon.icon.icon-sm-custom.link-tundora.fa-youtube(href='#')


//- Footer default
footer.page-foot.page-foot-default.section-35.bg-black.novi-background.text-center
	.container
		p.rights.small
			span= logo.name
			span &nbsp;&#169;&nbsp;
			span.copyright-year
			span All Rights Reserved
			br.d-md-none
			a.link-primary(href='privacy-policy.html') Privacy Policy

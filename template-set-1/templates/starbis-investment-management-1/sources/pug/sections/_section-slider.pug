//-Swiper
section
  .swiper-container.swiper-slider.swiper-variant-1.bg-black(data-loop='true', data-autoplay='5500', data-simulate-touch='true')
    .swiper-wrapper.text-center
      .swiper-slide(data-slide-bg='images/home-slider-1-slide-1.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-md-center
              .col-md-11.col-lg-10.col-xl-9
                .shilder-header-with-divider.d-none.d-lg-block(data-caption-animate='fadeInUp', data-caption-delay='0s')
                  | 20 years in Stock Market
                h2.slider-header(data-caption-animate='fadeInUp', data-caption-delay='100s')
                  | Manage Your Invesments
                  br
                  | Easily and Effectively
                a.btn.btn-icon.btn-icon-right.btn-primary.big(data-caption-animate='fadeInUp', data-caption-delay='250', href='#')
                  span.icon.icon-xs.fa-angle-right
                  | Get a Quote


      .swiper-slide(data-slide-bg='images/home-slider-1-slide-2.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-md-center.justify-content-xl-start
              .col-xl-1.d-none.d-xl-inline-block.d-xxl-none
              .col-md-11.col-lg-8.col-xl-6.text-xl-start
                h2.slider-header.text-ebony-clay(data-caption-animate='fadeInUp', data-caption-delay='0s')
                  | Does Your Money
                  br
                  | Need Speed?

                p.text-bigger.fw-normal.slider-text.text-ebony-clay(data-caption-animate='fadeInUp', data-caption-delay='100') Our company can assist you with any aspect of investment management
                a.btn.btn-icon.btn-icon-right.btn-primary.big(data-caption-animate='fadeInUp', data-caption-delay='250', href='#')
                  span.icon.icon-xs.fa-angle-right
                  | Get a Quote


    //-Swiper Navigation
    .swiper-scrollbar.d-xl-none
    .swiper-nav-wrap
      .swiper-button-prev
      .swiper-button-next

='\n'

extends  ../_skeleton

//- Includes
include ../elements/_ui-quote-default
include ../elements/_ui-placeholders

block variables
  - var activeIndex = 2
  - var pageName = 'Tables'

block title
  title=pageName

block page
  //-Page Header
  include ../sections/_section-header-default


  +page-title(pageName, 'bg-image-1')

  //-Tables
  section.section-top-60.section-md-top-100
    .container
      +table('table-custom-primary')

  section.section-top-60.section-md-top-100
    .container
      +table

  section.section-60.section-md-100
    .container
      +table(['table-custom-primary', 'table-custom-striped'])
  ='\n'


  //-Page Footer
  include ../sections/_section-footer-default
extends  ../_skeleton

//- Includes
include ../sections/_section-header-default

block variables
	- var activeIndex = 3
	- pageName = 'Buttons'

block page
	//- Page Header
	+header-default

	//- Page Content
	+page-title(pageName, 'bg-image-1')

	//- Buttons
	section.section.section-60.section-md-top-90.section-md-bottom-100
		.container
			.row.row-50.row-lg-90
				.col-sm-12
					h3 Button Sizes
					p.text-primary 4 different sizes: super, large, default and small.
					.group-lg.group-middle.mt-4
						.btn.btn-xl.btn-primary Super size
						.btn.btn-lg.btn-primary Large size
						.btn.btn-primary Default size
						.btn.btn-sm.btn-primary Small size

				.col-sm-12
					h3 Button Shapes
					p.text-primary 4 different shapes: default, round, square and circle.
					.group-lg.group-middle.mt-4
						.btn.btn-primary Default
						.btn.btn-primary.btn-round Round
						.btn.btn-primary.btn-rect Square
						.btn.btn-primary.btn-circle Circle

				.col-sm-12
					h3 Buttons with Icons
					p.text-primary Buttons are fully integrated with 900+ icons.
					.group-lg.group-middle.mt-4
						.btn.btn-icon.btn-icon-left.btn-primary
							span.novi-icon.icon.icon-xs-smaller.material-icons-shopping_cart
							| Icon Left
						.btn.btn-icon.btn-icon-right.btn-primary
							span.novi-icon.icon.icon-xs-smaller.material-icons-shopping_cart
							| Icon Right
						.btn.btn-icon.btn-icon-left.btn-primary-outline
							span.novi-icon.icon.icon-xs-smaller.material-icons-shopping_cart
							| Icon Left
						.btn.btn-icon.btn-icon-right.btn-primary-outline
							span.novi-icon.icon.icon-xs-smaller.material-icons-shopping_cart
							| Icon Right


	.divider

	//- Page Footer
	include ../sections/_section-footer-default

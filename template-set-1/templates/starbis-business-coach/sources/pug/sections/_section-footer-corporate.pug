//- Pre-footer
section.section.section-40.section-md-60.bg-cod-gray.novi-background
	.container
		.row.justify-content-sm-center
			.col-sm-10.col-md-11.col-lg-12
				.row.row-50
					.col-md-6.col-lg-4
						.inset-lg-right-30
							h6.text-uppercase About us
							p.offset-top-5 Zemez is an A-size depot of website templates - more than 46,000 designs to choose from.

						.group-md.group-top
							.group-item
								.unit.unit-spacing-xs
									.unit-left: span.novi-icon.icon.icon-xs-smaller.icon-primary.fa-phone
									.unit-body: a.link.link-bold.link-light-2(href='tel:#') +1 (232) 349–8447
								.inset-left-30
									a.link-light-2.fst-italic(href='mailto:#') info@demolink.org

							.group-item
								ul.list-inline.list-inline-reset
									li: a.novi-icon.icon.icon-round.icon-gray-dark-filled.icon-xxs-smallest.fa.fa-facebook(href='#')
									li: a.novi-icon.icon.icon-round.icon-gray-dark-filled.icon-xxs-smallest.fa.fa-twitter(href='#')
									li: a.novi-icon.icon.icon-round.icon-gray-dark-filled.icon-xxs-smallest.fa.fa-google-plus(href='#')

					.col-md-6.col-lg-4
						h6.text-uppercase Quick links
						.row.offset-top-5(style='max-width: 340px;')
							.col-6
								ul.list-marked-variant-2
									li: a(href='index.html') Home
									li: a(href='services.html') Services
									li: a(href='careers.html') Careers
									li: a(href='classic-blog.html') Blog

							.col-6
								ul.list-marked-variant-2
									li: a(href='about-us.html') About us
									li: a(href='contact-me.html') Contacts
									li: a(href='appointment.html') Appointment

					.col-md-6.col-lg-4
						h6.text-uppercase Subscribe
						p.offset-top-5 Get latest updates and offers.
						//- RD Mailform
						form.rd-mailform.form-classic.form-inline(data-form-output="form-output-global", data-form-type='subscribe', method='post', action='bat/rd-mailform.php')
							.form-wrap
								input#contact-email.form-input(type="email" name="email" data-constraints="@Email @Required")
								label.form-label(for="contact-email") Enter Your E-mail
							button(type="submit" aria-label='Subscribe').btn.btn-icon-only.btn-primary
								span.novi-icon.icon.icon-xs.icon-white.fa-envelope-o



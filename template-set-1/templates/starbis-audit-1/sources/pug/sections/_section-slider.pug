//- Swiper
section
  .swiper-container.swiper-slider.swiper-variant-1.bg-black(data-loop='true' data-autoplay='5500', data-simulate-touch='true')
    .swiper-wrapper.text-center
      .swiper-slide(data-slide-bg='images/home-slider-1-slide-1.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-sm-center
              .col-md-11.col-lg-10
                .text-white.text-uppercase.jumbotron-custom.border-modern(data-caption-animate='fadeInUp', data-caption-delay='0s') Upgrade #[span.text-thin your business]
                  span.border-modern-item-1
                  span.border-modern-item-2
                  span.border-modern-item-3
                  span.border-modern-item-4
                div(data-caption-animate='fadeInUp', data-caption-delay='450s')
                  p.text-big-19.text-white.d-none.d-md-inline-block We provide extensive assistance with any audit issues to modern bussinesses
                .button-block(data-caption-animate='fadeInUp', data-caption-delay='550s')
                  a.btn.btn-primary(href='appointment.html') make An Appointment

      .swiper-slide(data-slide-bg='images/bg-image-5.jpg')
        .swiper-slide-caption
          .container
            .row.justify-content-sm-center
              .col-md-11.col-lg-10.col-xl-12
                .text-white.text-uppercase.jumbotron-custom.border-modern(data-caption-animate='fadeInUp', data-caption-delay='0s') We Provide Proper Audit Solutions
                  span.border-modern-item-1
                  span.border-modern-item-2
                  span.border-modern-item-3
                  span.border-modern-item-4
                div(data-caption-animate='fadeInUp', data-caption-delay='450s')
                  p.text-big-19.text-white.d-none.d-md-inline-block Optimize audit costs using our years of experience
                .button-block(data-caption-animate='fadeInUp', data-caption-delay='550s')
                  a.btn.btn-primary(href='appointment.html') make An Appointment

    //- Swiper Navigation
    .swiper-scrollbar.d-xl-none
    .swiper-nav-wrap.d-none.d-xl-block
      .swiper-button-prev
      .swiper-button-next

='\n'
